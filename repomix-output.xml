import 'package:bloc_test/bloc_test.dart';

class MockGetUserUseCase extends Mock implements GetUserUseCase {}

void main() {
  group('UserCubit', () {
    late UserCubit cubit;
    late MockGetUserUseCase mockGetUserUseCase;
    
