    exit 1
}

# Validate environment
if ! validate_environment; then
    exit 1
fi

# Get app information for SSH key generation
APP_NAME=$(get_app_name)
VERSION=$(get_pubspec_version)

clear
log_info "🔑 SSH Key Generation with Centralized Configuration"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
