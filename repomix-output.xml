        cmd="$cmd --project \"$PROJECT_ID\""
        
        execute_firebase_command "$cmd"
        
        if [[ $((i + batch_size)) -lt ${#emails[@]} ]]; then
            log_info "Waiting 2 seconds before next batch..."
            sleep 2
        fi
    done
    
    if [[ "$DRY_RUN" == false ]]; then
        log_success "Added ${#emails[@]} testers to group: $GROUP_NAME"
    fi
}

# Function to remove testers from file from a specific group
remove_file_from_group() {
    if [[ -z "$GROUP_NAME" ]]; then
        log_error "Group name required. Use --group option"
        exit 1
    fi
    
    if [[ -z "$FILE_PATH" ]]; then
        FILE_PATH=".info/distribution/tester_list.txt"
        log_info "Using default file: $FILE_PATH"
    fi
    
    if [[ ! -f "$FILE_PATH" ]]; then
        log_error "File not found: $FILE_PATH"
        exit 1
    fi
    
    log_step "Removing testers from file from group: $GROUP_NAME"
    log_info "File: $FILE_PATH"
    
    local emails=()
    local temp_emails=$(read_emails_from_file "$FILE_PATH")
    while IFS= read -r email; do
        if [[ -n "$email" ]]; then
            emails+=("$email")
        fi
    done <<< "$temp_emails"
    
    if [[ ${#emails[@]} -eq 0 ]]; then
        log_error "No valid emails found in file"
        exit 1
    fi
    
    log_warning "Found ${#emails[@]} testers to remove from group:"
    for email in "${emails[@]}"; do
        echo "  - $email"
    done
    
    # Confirm removal
    if [[ "$DRY_RUN" == false ]]; then
        echo -n "Are you sure you want to remove these testers from group $GROUP_NAME? (y/N): "
        read -r confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
            log_info "Removal cancelled"
            exit 0
        fi
    fi
    
    local batch_size=100
    local batch_count=0
    
    for ((i=0; i<${#emails[@]}; i+=batch_size)); do
        batch_count=$((batch_count + 1))
        local batch_emails=("${emails[@]:$i:$batch_size}")
        
        log_info "Processing batch $batch_count (${#batch_emails[@]} testers)"
        
        local cmd="firebase appdistribution:testers:remove"
        
        for email in "${batch_emails[@]}"; do
            cmd="$cmd \"$email\""
        done
        
        cmd="$cmd --group-alias \"$GROUP_NAME\""
        cmd="$cmd --project \"$PROJECT_ID\""
        
        execute_firebase_command "$cmd"
        
        if [[ $((i + batch_size)) -lt ${#emails[@]} ]]; then
            log_info "Waiting 2 seconds before next batch..."
            sleep 2
        fi
    done
    
    if [[ "$DRY_RUN" == false ]]; then
        log_success "Removed ${#emails[@]} testers from group: $GROUP_NAME"
    fi
}

# Function to import testers from CSV
import_testers() {
    if [[ -z "$FILE_PATH" ]]; then
        log_error "CSV file path required. Use --file option"
        exit 1
    fi
    
    if [[ ! -f "$FILE_PATH" ]]; then
        log_error "File not found: $FILE_PATH"
        exit 1
    fi
    
    log_step "Importing testers from CSV file..."
    log_info "File: $FILE_PATH"
    
    # Read CSV file and extract emails
    local emails=()
    while IFS=',' read -r email name group _; do
        # Skip header row
        if [[ "$email" == "email" || "$email" == "Email" ]]; then
            continue
        fi
        
        # Clean email
        email=$(echo "$email" | tr -d ' ' | tr -d '"')
        
        if [[ -n "$email" ]]; then
            emails+=("$email")
        fi
    done < "$FILE_PATH"
    
    if [[ ${#emails[@]} -eq 0 ]]; then
        log_error "No valid emails found in CSV file"
        exit 1
    fi
    
    log_info "Found ${#emails[@]} testers to import"
    
    # Add testers in batches (Firebase has limits)
    local batch_size=100
    local batch_count=0
    
    for ((i=0; i<${#emails[@]}; i+=batch_size)); do
        batch_count=$((batch_count + 1))
        local batch_emails=("${emails[@]:$i:$batch_size}")
        
        log_info "Processing batch $batch_count (${#batch_emails[@]} testers)"
        
        local cmd="firebase appdistribution:testers:add"
        
        for email in "${batch_emails[@]}"; do
            cmd="$cmd \"$email\""
        done
        
        if [[ -n "$GROUP_NAME" ]]; then
            cmd="$cmd --group \"$GROUP_NAME\""
        fi
        
        cmd="$cmd --project \"$PROJECT_ID\""
        
        execute_firebase_command "$cmd"
        
        # Add delay between batches to avoid rate limiting
        if [[ $((i + batch_size)) -lt ${#emails[@]} ]]; then
            log_info "Waiting 2 seconds before next batch..."
            sleep 2
        fi
    done
    
    if [[ "$DRY_RUN" == false ]]; then
        log_success "Import completed: ${#emails[@]} testers processed"
    fi
}

# Function to export testers to CSV
export_testers() {
    if [[ -z "$FILE_PATH" ]]; then
        FILE_PATH="testers-export-$(date +%Y%m%d-%H%M%S).csv"
        log_info "No file specified, using: $FILE_PATH"
    fi
    
    log_step "Exporting testers to CSV file..."
    
    # Get testers list
    local cmd="firebase appdistribution:testers:list"
    
    if [[ -n "$GROUP_NAME" ]]; then
        cmd="$cmd $GROUP_NAME"
    fi
    
    cmd="$cmd --project \"$PROJECT_ID\" --json"
    
    if [[ "$DRY_RUN" == true ]]; then
        log_warning "[DRY RUN] Would export testers to: $FILE_PATH"
        log_info "Command: $cmd"
    else
        log_info "Fetching testers from Firebase..."
        
        # Execute command and capture output
        local testers_json=$(eval "$cmd" 2>/dev/null)
        
        # Create CSV header
        echo "email,display_name,groups,date_added" > "$FILE_PATH"
        
        # Parse JSON and write to CSV
        if [[ -n "$testers_json" ]]; then
            echo "$testers_json" | jq -r '.[] | [.email, .displayName // "", .groups // "" | join(";"), .dateAdded // ""] | @csv' >> "$FILE_PATH" 2>/dev/null || {
                log_warning "Could not parse tester data, saving raw JSON instead"
                echo "$testers_json" > "${FILE_PATH%.csv}.json"
                FILE_PATH="${FILE_PATH%.csv}.json"
            }
        fi
        
        log_success "Testers exported to: $FILE_PATH"
        log_info "File contains $(wc -l < "$FILE_PATH") lines"
    fi
}

# Function to manage testers in groups
manage_group_testers() {
    local action="$1"
    
    if [[ -z "$GROUP_NAME" ]]; then
        log_error "Group name required. Use --group option"
        exit 1
    fi
    
    if [[ ${#EMAILS[@]} -eq 0 ]]; then
        log_error "No emails provided"
        show_usage
        exit 1
    fi
    
    if [[ "$action" == "add" ]]; then
        log_step "Adding testers to group: $GROUP_NAME"
        COMMAND="add"
    else
        log_step "Removing testers from group: $GROUP_NAME"
        COMMAND="remove"
    fi
    
    # Use the add/remove functions with group specified
    if [[ "$action" == "add" ]]; then
        add_testers
    else
        remove_testers
    fi
}

# Main function
main() {
    log_info "🧑‍🤝‍🧑 Firebase App Distribution - Tester Management"
    
    # Parse arguments
    parse_arguments "$@"
    
    # Validate command - show help if no command provided
    if [[ -z "$COMMAND" ]]; then
        show_usage
        exit 0
    fi
    
    # Check prerequisites
    if ! command -v firebase &> /dev/null; then
        log_error "Firebase CLI is not installed. Please install it first:"
        echo "npm install -g firebase-tools"
        exit 1
    fi
    
    log_info "Using project: $PROJECT_ID"
    
    if [[ "$DRY_RUN" == true ]]; then
        log_warning "DRY RUN MODE - No changes will be made"
    fi
    
    # Execute command
    case "$COMMAND" in
        list)
            list_testers
            ;;
        add)
            add_testers
            ;;
        remove)
            remove_testers
            ;;
        add-to-group)
            manage_group_testers "add"
            ;;
        remove-from-group)
            manage_group_testers "remove"
            ;;
        import)
            import_testers
            ;;
        import-from-file)
            import_from_file
            ;;
        add-file-to-group)
            add_file_to_group
            ;;
        remove-file-from-group)
            remove_file_from_group
            ;;
        export)
            export_testers
            ;;
        *)
            log_error "Unknown command: $COMMAND"
            show_usage
            exit 1
            ;;
    esac
    
    log_success "Operation completed"
}

# Run main function
main "$@"
</file>

<file path="tools/macos/distribution/README.md">
# Firebase App Distribution Tools

Comprehensive tools for managing Firebase App Distribution including building, distributing, and managing testers and groups.

## 📋 Table of Contents

- [Overview](#overview)
- [Prerequisites](#prerequisites)
- [Quick Start](#quick-start)
- [Available Tools](#available-tools)
- [Usage Examples](#usage-examples)
- [Configuration](#configuration)
- [Best Practices](#best-practices)
- [Troubleshooting](#troubleshooting)

## 🎯 Overview

This directory contains enhanced Firebase App Distribution tools that:

- **Dynamic Configuration**: All settings pulled from centralized `.info/` configuration
- **Command Visibility**: All Firebase commands are printed before execution
- **Automated Workflows**: Build and distribute in one command
- **Tester Management**: Add, remove, import/export testers
- **Group Management**: Create, sync, and manage distribution groups
- **Cross-Platform**: Support for both Android (APK/AAB) and iOS (IPA)

## 📦 Prerequisites

### Required Tools

```bash
# Firebase CLI
npm install -g firebase-tools

# jq (JSON processor)
brew install jq

# Flutter/FVM (if using)
# Already configured in your project
```

### Firebase Setup

1. **Install Firebase CLI** and login:
   ```bash
   firebase login
   ```

2. **Configure Firebase project** in `.info/firebase.json`:
   ```json
   {
     "projects": {
       "dev": "your-project-dev",
       "stg": "your-project-stg",
       "prod": "your-project-prod"
     },
     "apps": {
       "android": {
         "dev": { "appId": "1:xxx:android:xxx" },
         "stg": { "appId": "1:xxx:android:xxx" },
         "prod": { "appId": "1:xxx:android:xxx" }
       },
       "ios": {
         "dev": { "appId": "1:xxx:ios:xxx" },
         "stg": { "appId": "1:xxx:ios:xxx" },
         "prod": { "appId": "1:xxx:ios:xxx" }
       }
     },
     "distribution": {
       "testers": {
         "dev": ["tester1@example.com", "tester2@example.com"],
         "stg": ["qa@example.com"],
         "prod": ["beta@example.com"]
       },
       "groups": {
         "dev": ["dev-team", "qa-team"],
         "stg": ["qa-team"],
         "prod": ["beta-testers"]
       },
       "releaseNotes": {
         "template": "Version {{version}} - {{flavor}} build\\n\\nReleased on {{date}}"
       }
     }
   }
   ```

## 🚀 Quick Start

### 1. Distribute Android APK

```bash
# Build and distribute in one command
./tools/macos/build/build_apk.sh dev --distribute

# Or distribute existing build
./tools/macos/distribution/distribute_android.sh apk dev
```

### 2. Distribute iOS IPA

```bash
# Build and distribute
./tools/macos/distribution/distribute_ios.sh dev --build-first

# Or distribute existing build
./tools/macos/distribution/distribute_ios.sh prod
```

### 3. Manage Testers

```bash
# List testers
./tools/macos/distribution/manage_testers.sh list

# Add testers
./tools/macos/distribution/manage_testers.sh add user1@example.com user2@example.com

# Add testers to group
./tools/macos/distribution/manage_testers.sh add-to-group --group qa-team user@example.com
```

### 4. Manage Groups

```bash
# List groups
./tools/macos/distribution/manage_groups.sh list

# Create group
./tools/macos/distribution/manage_groups.sh create "QA Team" qa-team

# Sync groups from config
./tools/macos/distribution/manage_groups.sh sync --flavor dev
```

## 🛠️ Available Tools

### Distribution Scripts

All distribution tools use centralized configuration and print commands before execution.

#### `distribute_android.sh`
```bash
./distribute_android.sh [apk|appbundle] [dev|stg|prod] [--build-first] [--dry-run]
```

#### `distribute_ios.sh`
```bash
./distribute_ios.sh [dev|stg|prod] [--build-first] [--ipa <path>] [--dry-run]
```

### Tester Management

#### `manage_testers.sh`
```bash
./manage_testers.sh <command> [options]

Commands:
  list, add, remove, add-to-group, remove-from-group, import, export
```

### Group Management

#### `manage_groups.sh`
```bash
./manage_groups.sh <command> [options]

Commands:
  list, create, delete, show, sync
```

### Enhanced Build Tools

```bash
# Build with distribution
./tools/macos/build/build_apk.sh dev --distribute
./tools/macos/build/build_apk.sh prod --distribute --group beta-testers
```

## 📖 Usage Examples

See the detailed examples in the full documentation sections above.

## ⚙️ Configuration

All configuration is centralized in `.info/firebase.json`. Environment variables can override settings:

```bash
export FIREBASE_DISTRIBUTION_TESTERS="custom@example.com"
export FIREBASE_DISTRIBUTION_GROUP="custom-group"
```

## 🎯 Best Practices

1. **Always test with --dry-run first**
2. **Organize testers with groups**  
3. **Regular backups of tester lists**
4. **Sync groups regularly**
5. **Automate distribution in CI/CD**

## 🔍 Troubleshooting

Common issues and solutions:

1. **Firebase CLI Not Authenticated**: `firebase login`
2. **App ID Not Found**: Verify `.info/firebase.json`
3. **Distribution Fails**: Update Firebase CLI
4. **Tester Not Receiving**: Re-add to group
5. **Group Not Found**: Run sync command

## 📚 Resources

- [Firebase App Distribution Docs](https://firebase.google.com/docs/app-distribution)
- [Firebase CLI Reference](https://firebase.google.com/docs/cli)

---

For detailed usage, run any script with `--help` flag.
