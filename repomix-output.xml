    log_step "Importing testers from text file..."
    log_info "File: $FILE_PATH"
    
    local emails=()
    local temp_emails=$(read_emails_from_file "$FILE_PATH")
    while IFS= read -r email; do
        if [[ -n "$email" ]]; then
            emails+=("$email")
