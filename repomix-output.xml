}

# Parse command-line arguments
IPA_PATH="$DEFAULT_IPA_PATH"
API_KEY="$DEFAULT_API_KEY"
ISSUER_ID="$DEFAULT_ISSUER_ID"
DISTRIBUTION="$DEFAULT_DISTRIBUTION"
