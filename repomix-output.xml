            ;;
        export)
            export_testers
            ;;
        *)
            log_error "Unknown command: $COMMAND"
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"
</file>

<file path="tools/linux/git/hooks/commit-msg">
#!/bin/bash

# Commit message validation hook for GitFlow
# This hook validates commit messages against the project's commit convention

# Get the commit message
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Define valid commit types
VALID_TYPES="feature|fix|hotfix|release|docs|style|refactor|test|chore"

# Commit message pattern
# Format: type(scope): subject
# Examples:
#   feature(auth): Add social login
#   fix(payment): Fix credit card validation
#   feature-TG-123-login: Add OAuth integration
PATTERN="^($VALID_TYPES)(\([a-zA-Z0-9-]+\))?(-[A-Z]+-[0-9]+)?(-[a-z0-9-]+)?: .+"

# Check if commit message matches the pattern
if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo -e "${RED}❌ Invalid commit message format!${NC}"
    echo ""
    echo -e "${YELLOW}Commit message:${NC} $COMMIT_MSG"
    echo ""
    echo -e "${GREEN}Valid format:${NC} type(scope): subject"
    echo -e "${GREEN}Or with ticket:${NC} type-TICKET-ID-description: subject"
    echo ""
    echo -e "${GREEN}Valid types:${NC} $VALID_TYPES"
    echo ""
    echo -e "${GREEN}Examples:${NC}"
    echo "  feature(auth): Add social login functionality"
    echo "  fix(validation): Fix email regex pattern"
    echo "  feature-ARTLEXIS-123-login: Implement OAuth2 authentication"
    echo "  fix-TG-456: Resolve payment gateway timeout"
    echo ""
    echo -e "${YELLOW}💡 Tip:${NC} Use branch ticket ID in your commit for traceability"
    exit 1
fi

# Check commit message length
SUBJECT_LENGTH=${#COMMIT_MSG}
if [ $SUBJECT_LENGTH -gt 100 ]; then
    echo -e "${YELLOW}⚠️  Warning: Commit message is too long (${SUBJECT_LENGTH} chars)${NC}"
    echo "Consider keeping it under 100 characters for better readability."
    echo ""
fi

# Extract type and validate specific rules
TYPE=$(echo "$COMMIT_MSG" | sed -E 's/^([a-z]+).*/\1/')

# Ensure feature commits reference a ticket when on feature branches
CURRENT_BRANCH=$(git branch --show-current)
if [[ "$CURRENT_BRANCH" =~ ^(feature|fix|hotfix)/ ]]; then
    # Extract ticket ID from branch name
    BRANCH_TICKET=$(echo "$CURRENT_BRANCH" | sed -E 's/^[^\/]+\/([A-Z]+-[0-9]+)-.*/\1/')
    
    # Check if commit message contains the ticket ID
    if [[ -n "$BRANCH_TICKET" ]] && [[ ! "$COMMIT_MSG" =~ $BRANCH_TICKET ]]; then
        echo -e "${YELLOW}💡 Tip: Your branch references ticket $BRANCH_TICKET${NC}"
        echo "Consider including it in your commit message for better traceability."
        echo ""
    fi
fi

echo -e "${GREEN}✅ Commit message validated successfully!${NC}"
exit 0
</file>

<file path="tools/linux/git/hooks/pre-push">
#!/bin/bash

# Pre-push hook for GitFlow validation
# This hook validates branch names and prevents direct pushes to protected branches

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Protected branches that should not receive direct pushes
PROTECTED_BRANCHES="main|master|develop"

# Get the current branch
CURRENT_BRANCH=$(git branch --show-current)

# Function to validate branch name format
validate_branch_name() {
    local branch="$1"
    
    # Skip validation for protected branches (they might already exist)
    if [[ "$branch" =~ ^($PROTECTED_BRANCHES)$ ]]; then
        return 0
    fi
    
    # Valid branch patterns
    local FEATURE_PATTERN="^feature/[A-Z]+-[0-9]+-[a-z0-9-]+$"
    local FIX_PATTERN="^fix/[A-Z]+-[0-9]+-[a-z0-9-]+$"
    local RELEASE_PATTERN="^release/[0-9]+\.[0-9]+\.[0-9]+$"
    local HOTFIX_PATTERN="^hotfix/[A-Z]+-[0-9]+-[a-z0-9-]+$"
    
    if [[ "$branch" =~ $FEATURE_PATTERN ]] || \
       [[ "$branch" =~ $FIX_PATTERN ]] || \
       [[ "$branch" =~ $RELEASE_PATTERN ]] || \
       [[ "$branch" =~ $HOTFIX_PATTERN ]]; then
        return 0
    fi
    
    return 1
}

# Check if pushing to protected branch
if [[ "$CURRENT_BRANCH" =~ ^($PROTECTED_BRANCHES)$ ]]; then
    echo -e "${YELLOW}⚠️  Warning: You're pushing directly to protected branch: $CURRENT_BRANCH${NC}"
    echo "Consider using GitFlow workflow with feature/fix/release/hotfix branches."
    echo ""
    read -p "Are you sure you want to continue? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${RED}❌ Push cancelled${NC}"
        exit 1
    fi
fi

# Validate branch name format
if ! validate_branch_name "$CURRENT_BRANCH"; then
    echo -e "${RED}❌ Invalid branch name format: $CURRENT_BRANCH${NC}"
    echo ""
    echo -e "${GREEN}Valid formats:${NC}"
    echo "  feature/TICKET-ID-description  (e.g., feature/TG-123-login-social)"
    echo "  fix/TICKET-ID-description      (e.g., fix/TG-456-validation-bug)"
    echo "  release/VERSION                (e.g., release/1.2.0)"
    echo "  hotfix/TICKET-ID-description   (e.g., hotfix/TG-789-critical-fix)"
    echo ""
    echo -e "${YELLOW}Please rename your branch to follow the GitFlow convention.${NC}"
    exit 1
fi

# Check for work-in-progress commits
WIP_COMMITS=$(git log origin/$CURRENT_BRANCH..HEAD --grep="WIP\|wip\|Work in progress" --oneline)
if [[ -n "$WIP_COMMITS" ]]; then
    echo -e "${YELLOW}⚠️  Found work-in-progress commits:${NC}"
    echo "$WIP_COMMITS"
    echo ""
    echo "Consider squashing or rewording these commits before pushing."
    read -p "Push anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${RED}❌ Push cancelled${NC}"
        echo "Use 'git rebase -i' to clean up your commits."
        exit 1
    fi
fi

# Run tests if available
if [ -f "pubspec.yaml" ] && command -v flutter &> /dev/null; then
    echo -e "${YELLOW}🧪 Running Flutter analyze...${NC}"
    flutter analyze --no-fatal-infos
    if [ $? -ne 0 ]; then
        echo -e "${RED}❌ Flutter analyze found issues${NC}"
        echo "Please fix the issues before pushing."
        exit 1
    fi
fi

echo -e "${GREEN}✅ Pre-push validation passed!${NC}"
exit 0
</file>

