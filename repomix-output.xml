  }

  @override
  Future<void> cacheUserProgressMyCourses(List<CourseModel> models) async {
    try {
      final jsonList = models.map((model) => model.toJson()).toList();
      await _localStoreService.setMap(key: _cacheMyCoursesKey, value: {'items': jsonList});
    } catch (e) {
      //
    }
  }

  @override
