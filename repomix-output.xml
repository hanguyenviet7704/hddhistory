  Color _getStatusColor(UserStatus status, AppColors colors) {
    switch (status) {
      case UserStatus.active:
        return colors.success;
      case UserStatus.inactive:
        return colors.warning;
      case UserStatus.blocked:
        return colors.error;
    }
  }
