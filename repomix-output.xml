set "CONFIG_DIR=%WINDOWS_TOOLS_DIR%\config"
set "DISTRIBUTION_DIR=%WINDOWS_TOOLS_DIR%\distribution"
set "KEY_DIR=%WINDOWS_TOOLS_DIR%\key"

