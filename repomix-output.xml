if [[ -z "$FIREBASE_APP_ID" || "$FIREBASE_APP_ID" == "null" ]]; then
    log_warning "Firebase App ID not found in centralized config, extracting from google-services.json"

    # Extract Firebase App ID from google-services.json
    if command -v jq &> /dev/null; then
        log_info "Using jq to parse JSON..."
        echo "Command: jq -r --arg pkg \"$EXPECTED_PACKAGE\" '.client[] | select(.client_info.android_client_info.package_name == \$pkg) | .client_info.mobilesdk_app_id' \"$GOOGLE_SERVICES_FILE\""
        FIREBASE_APP_ID=$(jq -r --arg pkg "$EXPECTED_PACKAGE" '.client[] | select(.client_info.android_client_info.package_name == $pkg) | .client_info.mobilesdk_app_id' "$GOOGLE_SERVICES_FILE")
    else
        log_warning "jq not found, using grep/sed method..."
        echo "Command: grep -A 10 \"\\\"package_name\\\": \\\"$EXPECTED_PACKAGE\\\"\" \"$GOOGLE_SERVICES_FILE\" | grep -B 10 \"mobilesdk_app_id\" | grep \"mobilesdk_app_id\" | head -1 | sed 's/.*\"mobilesdk_app_id\": \"\\([^\"]*\\)\".*/\\1/'"
        FIREBASE_APP_ID=$(grep -A 10 "\"package_name\": \"$EXPECTED_PACKAGE\"" "$GOOGLE_SERVICES_FILE" | grep -B 10 "mobilesdk_app_id" | grep "mobilesdk_app_id" | head -1 | sed 's/.*"mobilesdk_app_id": "\([^"]*\)".*/\1/')
    fi
fi

# Show configuration summary
show_config_summary "$FLAVOR" "android"

echo
log_info "🔍 Debug symbols verification for $FLAVOR environment (Linux)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Project: $FIREBASE_PROJECT_ID"
echo "Package: $EXPECTED_PACKAGE"
echo "Firebase App ID: $FIREBASE_APP_ID"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo

log_step "📍 Console Links:"
echo "• Main Dashboard: $CONSOLE_URL"
echo "• Debug Symbols: $CONSOLE_URL/settings/symbols"
echo "• Issues/Crashes: $CONSOLE_URL/issues"
echo

log_step "🔧 CLI Commands to check uploads:"
echo "Command: firebase crashlytics:symbols:list --app=\"$FIREBASE_APP_ID\""
echo

# Get debug symbols path from centralized configuration
DEBUG_SYMBOLS_PATH=$(get_debug_info_path)
if [[ -z "$DEBUG_SYMBOLS_PATH" ]]; then
    DEBUG_SYMBOLS_PATH=".obfuscation"  # fallback
fi

log_step "📁 Local debug symbols info:"
if [[ -d "$DEBUG_SYMBOLS_PATH" ]]; then
    log_success "Debug symbols directory: EXISTS"
    echo "Path: $DEBUG_SYMBOLS_PATH"
    echo "Files in $DEBUG_SYMBOLS_PATH:"
    ls -la "$DEBUG_SYMBOLS_PATH/" | grep -v "^total" | grep -v "^d"
else
    log_warning "Debug symbols directory: NOT FOUND"
    log_info "Path checked: $DEBUG_SYMBOLS_PATH"
    log_info "Run a build with obfuscation to generate symbols first"
fi

echo
log_step "🌐 Opening Firebase Console in browser..."
echo "Opening: $CONSOLE_URL/settings/symbols"

# Linux browser opening
if command -v xdg-open > /dev/null; then
    xdg-open "$CONSOLE_URL/settings/symbols"
elif command -v gnome-open > /dev/null; then
    gnome-open "$CONSOLE_URL/settings/symbols"
elif command -v kde-open > /dev/null; then
    kde-open "$CONSOLE_URL/settings/symbols"
else
    log_info "Could not open browser automatically. Please navigate to:"
    echo "$CONSOLE_URL/settings/symbols"
fi
</file>

<file path="tools/linux/distribution/distribute_android.sh">
#!/bin/bash

# Enhanced Android Distribution Script with Centralized Configuration (Linux)
# This script distributes Android apps using Firebase App Distribution

# Enable strict error handling
set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source the common configuration
source "${SCRIPT_DIR}/../common/common.sh" || {
    echo "❌ Failed to load common configuration"
    exit 1
}

# Function to check prerequisites
check_prerequisites() {
    log_step "Checking prerequisites..."
    
    # Check if Firebase CLI is installed
    if ! command -v firebase &> /dev/null; then
        log_error "Firebase CLI is not installed. Please install it first:"
        echo "npm install -g firebase-tools"
        exit 1
    fi
    
    # Validate environment
    if ! validate_environment; then
        exit 1
    fi
    
    log_success "All prerequisites are met!"
}

# Function to load Firebase configuration
load_firebase_config() {
    local flavor="$1"
    local platform="$2"
    
    PROJECT_ID=$(get_firebase_project_id "$flavor")
    APP_ID=$(get_firebase_app_id "$platform" "$flavor")
    
    # Get testers and groups - combines JSON config and text files
    TESTERS=$(get_all_testers "$flavor")
    TESTER_GROUPS=$(get_all_groups "$flavor")
    
    if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "null" || -z "$APP_ID" || "$APP_ID" == "null" ]]; then
        log_error "Firebase configuration not found for flavor: $flavor, platform: $platform"
        exit 1
    fi
    
    log_info "Loaded Firebase config:"
    echo "  ${CYAN}Project ID:${NC} $PROJECT_ID"
    echo "  ${CYAN}App ID:${NC} $APP_ID"
    echo "  ${CYAN}Testers:${NC} ${TESTERS:-'(none)'}"
    echo "  ${CYAN}Groups:${NC} ${TESTER_GROUPS:-'(none)'}"
}

# Function to get app version (using centralized function)
get_app_version() {
    get_pubspec_version
}

# Function to distribute to Firebase
distribute_to_firebase() {
    local file_path="$1"
    local flavor="$2"
    local build_type="$3"
    local dry_run="${4:-false}"
    
    if [[ ! -f "$file_path" ]]; then
        log_error "Build file not found: $file_path"
        exit 1
    fi
    
    log_info "Distributing $build_type to Firebase App Distribution..."
    
    # Load Firebase configuration
    load_firebase_config "$flavor" "android"
    
    # Get app version
    local version=$(get_app_version)
    
    # Generate release notes
    generate_release_notes "$flavor" "$version" "$build_type" "Android (Linux)"
    
    # Create a temporary file for release notes
    local release_notes_file=$(mktemp)
    printf "%b\n" "$RELEASE_NOTES" > "$release_notes_file"
    
    # Build Firebase distribution command
    local firebase_cmd="firebase appdistribution:distribute \"$file_path\" --project \"$PROJECT_ID\" --app \"$APP_ID\" --release-notes-file \"$release_notes_file\""
    
    # Add testers if configured
    if [[ -n "$TESTERS" && "$TESTERS" != "null" ]]; then
        firebase_cmd="$firebase_cmd --testers \"$TESTERS\""
    fi
    
    # Add groups if configured
    if [[ -n "$TESTER_GROUPS" && "$TESTER_GROUPS" != "null" ]]; then
        firebase_cmd="$firebase_cmd --groups \"$TESTER_GROUPS\""
    fi
    
    # Print the command that will be executed
    log_step "Firebase App Distribution command:"
    echo "${PURPLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo "${CYAN}$firebase_cmd${NC}"
    echo "${PURPLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    # Execute the Firebase distribution command (skip if dry-run)
    if [[ "$dry_run" == "true" ]]; then
        log_warning "[DRY RUN] Command not executed"
        log_success "Dry-run completed successfully!"
    elif eval "$firebase_cmd"; then
        log_success "$build_type distributed successfully!"
        log_info "Check Firebase Console: https://console.firebase.google.com/project/$PROJECT_ID/appdistribution"
    else
        log_error "Failed to distribute $build_type"
        rm -f "$release_notes_file"
        exit 1
    fi
    
    # Clean up
    rm -f "$release_notes_file"
}

# Function to send Slack notification
send_slack_notification() {
    local flavor="$1"
    local build_type="$2"
    local status="$3"
    
    local webhook_url=$(jq -r '.slack.webhookUrl' "$FIREBASE_INFO_FILE")
    local channel=$(jq -r ".slack.channels.$flavor" "$FIREBASE_INFO_FILE")
    
    if [[ -n "$webhook_url" && "$webhook_url" != "null" && "$webhook_url" != "" ]]; then
        local version=$(get_app_version)
        local emoji="✅"
        local color="good"
        
        if [[ "$status" != "success" ]]; then
            emoji="❌"
            color="danger"
        fi
        
        local payload=$(cat <<EOF
{
    "channel": "$channel",
    "attachments": [
        {
            "color": "$color",
            "title": "$emoji Firebase App Distribution - $build_type",
            "fields": [
                {
                    "title": "Version",
                    "value": "$version",
                    "short": true
                },
                {
                    "title": "Flavor",
                    "value": "$flavor",
                    "short": true
                },
                {
                    "title": "Status",
                    "value": "$status",
                    "short": true
                },
                {
                    "title": "Platform",
                    "value": "Android (Linux)",
                    "short": true
                }
            ]
        }
    ]
}
EOF
)
        
        curl -X POST -H 'Content-type: application/json' --data "$payload" "$webhook_url" > /dev/null 2>&1 || true
        log_info "Slack notification sent to $channel"
    fi
}

# Function to show usage
show_usage() {
    echo "Usage: $(basename "$0") [apk|appbundle] [dev|stg|prod] [options]"
    echo ""
    echo "Arguments:"
    echo "  apk|appbundle    Type of build to distribute"
    echo "  dev|stg|prod     Environment flavor"
    echo ""
    echo "Options:"
    echo "  --build-first    Build before distributing"
    echo "  --dry-run        Show what would be executed without actually doing it"
    echo "  --verbose        Show detailed output"
    echo "  -h, --help       Show this help message"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") apk dev --build-first    # Build and distribute APK for dev"
    echo "  $(basename "$0") appbundle prod           # Distribute existing App Bundle for prod"
    echo "  $(basename "$0") apk stg --dry-run        # Show distribution commands without executing"
}

# Main function
main() {
    log_info "🚀 Firebase App Distribution - Android"
    
    # Parse arguments
    local build_type=""
    local flavor=""
    local should_build=false
    local dry_run=false
    local verbose=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            apk|appbundle)
                build_type="$1"
                shift
                ;;
            dev|stg|prod)
                flavor="$1"
                shift
                ;;
            --build-first)
                should_build=true
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            -h|--help)
                show_usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                show_usage
                exit 1
                ;;
        esac
    done
    
    # Validate required arguments
    if [[ -z "$build_type" || -z "$flavor" ]]; then
        log_error "Missing required arguments"
        show_usage
        exit 1
    fi
    
    # Validate build type
    if [[ "$build_type" != "apk" && "$build_type" != "appbundle" ]]; then
        log_error "Invalid build type. Use 'apk' or 'appbundle'"
        exit 1
    fi
    
    # Validate flavor using centralized function
    if ! validate_flavor "$flavor"; then
        exit 1
    fi
    
    # Show configuration summary
    show_config_summary "$flavor" "android"
    
    # Navigate to root directory
    cd "$PROJECT_ROOT" || {
        log_error "Failed to navigate to the project root directory."
        exit 1
    }
    
    # Check prerequisites
    check_prerequisites
    
    # Build first if requested
    if [[ "$should_build" == true ]]; then
        log_step "Building $build_type for $flavor flavor..."
        
        local build_script=""
        if [[ "$build_type" == "apk" ]]; then
            build_script="${SCRIPT_DIR}/../build/build_apk.sh"
        else
            build_script="${SCRIPT_DIR}/../build/build_appbundle.sh"
        fi
        
        if [[ "$dry_run" == true ]]; then
            log_info "[DRY RUN] Would execute: $build_script $flavor"
        else
            log_step "Executing build command:"
            echo "${CYAN}$build_script $flavor${NC}"
            
            if ! "$build_script" "$flavor"; then
                log_error "Build failed!"
                send_slack_notification "$flavor" "$build_type" "build_failed"
                exit 1
            fi
        fi
    fi
    
    # Determine file path based on build type
    local file_path
    if [[ "$build_type" == "apk" ]]; then
        file_path="$ANDROID_OUTPUT_DIR/flutter-apk/app-$flavor-release.apk"
    else
        file_path="$ANDROID_OUTPUT_DIR/bundle/${flavor}Release/app-$flavor-release.aab"
    fi
    
    # Check if file exists before distribution
    if [[ ! -f "$file_path" ]]; then
        log_error "Build file not found: $file_path"
        log_info "Please build the $build_type first or use --build-first option"
        exit 1
    fi
    
    log_info "Found build file: $file_path"
    log_info "File size: $(du -h "$file_path" | cut -f1)"
    
    if [[ "$dry_run" == true ]]; then
        log_warning "[DRY RUN MODE] - Commands will be shown but not executed"
    fi
    
    # Distribute to Firebase
    distribute_to_firebase "$file_path" "$flavor" "$build_type" "$dry_run"
    
    # Send success notification
    send_slack_notification "$flavor" "$build_type" "success"
    
    log_success "🎉 Distribution completed successfully!"
    
    # Show next steps
    echo ""
    log_info "Next steps:"
    echo "  1. Check Firebase Console: https://console.firebase.google.com/project/$PROJECT_ID/appdistribution"
    echo "  2. Testers will receive email invitations"
    echo "  3. Monitor installation and feedback"
}

# Run main function with all arguments
main "$@"
</file>

<file path="tools/linux/distribution/manage_distribution_data.sh">
#!/bin/bash

# Distribution Data File Manager (Linux)
# This script manages tester lists, groups, release notes, and test devices in text files

set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source the common configuration
source "${SCRIPT_DIR}/../common/common.sh" || {
    echo "❌ Failed to load common configuration"
    exit 1
}

# Function to show usage
show_usage() {
    echo "Usage: $(basename "$0") <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init                      Initialize distribution data files with examples"
    echo "  sync-app-ids              Sync Firebase app IDs from firebase.json"
    echo "  edit <file>               Edit a distribution data file"
    echo "  show [file]               Show content of distribution data files"
    echo "  add-tester <email>        Add tester to tester_list.txt"
    echo "  add-group <group>         Add group to tester_group.txt"
    echo "  set-release-note          Set custom release notes"
    echo "  add-device <device>       Add test device"
    echo "  set-password              Set test password"
    echo "  sync-to-firebase          Sync data files to Firebase"
    echo "  validate                  Validate all data files"
    echo ""
    echo "File options:"
    echo "  tester-list       Tester email addresses"
    echo "  tester-group      Distribution group names"
    echo "  release-note      Custom release notes"
    echo "  test-device       Test devices for automation"
    echo "  test-password     Test account password"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") init"
    echo "  $(basename "$0") sync-app-ids"
    echo "  $(basename "$0") show"
    echo "  $(basename "$0") add-tester user@example.com"
    echo "  $(basename "$0") add-group qa-team"
    echo "  $(basename "$0") edit tester-list"
    echo "  $(basename "$0") sync-to-firebase --flavor dev"
    echo ""
    echo "Note: Uses Linux text editors (nano, vim, or default EDITOR)"
}

# Function to ensure distribution directory exists
ensure_distribution_dir() {
    if [[ ! -d "$INFO_DIST_DIR" ]]; then
        log_info "Creating distribution data directory: $INFO_DIST_DIR"
        mkdir -p "$INFO_DIST_DIR"
    fi
}

# Function to initialize distribution data files
init_distribution_files() {
    log_step "Initializing distribution data files..."
    ensure_distribution_dir

    # Create tester list file
    if [[ ! -f "$TESTER_LIST_FILE" ]]; then
        cat > "$TESTER_LIST_FILE" << 'EOF'
# Tester Email List
# Add one email address per line
# Lines starting with # are comments and will be ignored
#
# Example:
# user1@example.com
# user2@example.com
# qa-team@company.com

EOF
        log_success "Created: $TESTER_LIST_FILE"
    else
        log_info "Already exists: $TESTER_LIST_FILE"
    fi

    # Create tester group file
    if [[ ! -f "$TESTER_GROUP_FILE" ]]; then
        cat > "$TESTER_GROUP_FILE" << 'EOF'
# Tester Group List
# Add one group name per line
# Lines starting with # are comments and will be ignored
#
# Example:
# qa-team
# beta-users
# internal-testers

EOF
        log_success "Created: $TESTER_GROUP_FILE"
    else
        log_info "Already exists: $TESTER_GROUP_FILE"
    fi

    # Create release notes file
    if [[ ! -f "$RELEASE_NOTE_FILE" ]]; then
        cat > "$RELEASE_NOTE_FILE" << 'EOF'
# Custom Release Notes
# This file contains custom release notes for Firebase App Distribution
# You can use variables: {{version}}, {{flavor}}, {{date}}
#
# Example:
Version {{version}} for {{flavor}} environment

🚀 New Features:
- Feature description here

🐛 Bug Fixes:
- Bug fix description here

📱 Built on Linux: {{date}}

EOF
        log_success "Created: $RELEASE_NOTE_FILE"
    else
        log_info "Already exists: $RELEASE_NOTE_FILE"
    fi

    # Create test device file
    if [[ ! -f "$TEST_DEVICE_FILE" ]]; then
        cat > "$TEST_DEVICE_FILE" << 'EOF'
# Test Device List
# Add device identifiers for automated testing
# Lines starting with # are comments and will be ignored
#
# Example:
# emulator-5554
# device-serial-123
# android-device-1

EOF
        log_success "Created: $TEST_DEVICE_FILE"
    else
        log_info "Already exists: $TEST_DEVICE_FILE"
    fi

    # Create test password file
    if [[ ! -f "$TEST_PASSWORD_FILE" ]]; then
        cat > "$TEST_PASSWORD_FILE" << 'EOF'
# Test Account Password
# Store test account passwords here (one per line)
# Lines starting with # are comments and will be ignored
#
# WARNING: Be careful with password storage!
# Consider using environment variables instead
#
# Example:
# test-password-123

EOF
        log_success "Created: $TEST_PASSWORD_FILE"
    else
        log_info "Already exists: $TEST_PASSWORD_FILE"
    fi

    log_success "Distribution data files initialized!"
}

# Function to show file contents
show_files() {
    local file_type="$1"

    if [[ -n "$file_type" ]]; then
        case "$file_type" in
            tester-list)
                if [[ -f "$TESTER_LIST_FILE" ]]; then
                    log_step "Tester List ($TESTER_LIST_FILE):"
                    cat "$TESTER_LIST_FILE"
                else
                    log_warning "Tester list file not found: $TESTER_LIST_FILE"
                fi
                ;;
            tester-group)
                if [[ -f "$TESTER_GROUP_FILE" ]]; then
                    log_step "Tester Groups ($TESTER_GROUP_FILE):"
                    cat "$TESTER_GROUP_FILE"
                else
                    log_warning "Tester group file not found: $TESTER_GROUP_FILE"
                fi
                ;;
            release-note)
                if [[ -f "$RELEASE_NOTE_FILE" ]]; then
                    log_step "Release Notes ($RELEASE_NOTE_FILE):"
                    cat "$RELEASE_NOTE_FILE"
                else
                    log_warning "Release notes file not found: $RELEASE_NOTE_FILE"
                fi
                ;;
            test-device)
                if [[ -f "$TEST_DEVICE_FILE" ]]; then
                    log_step "Test Devices ($TEST_DEVICE_FILE):"
                    cat "$TEST_DEVICE_FILE"
                else
                    log_warning "Test device file not found: $TEST_DEVICE_FILE"
                fi
                ;;
            test-password)
                if [[ -f "$TEST_PASSWORD_FILE" ]]; then
                    log_step "Test Password ($TEST_PASSWORD_FILE):"
                    log_warning "Password file content hidden for security"
                    echo "[Content hidden - use 'edit test-password' to view/modify]"
                else
                    log_warning "Test password file not found: $TEST_PASSWORD_FILE"
                fi
                ;;
            *)
                log_error "Unknown file type: $file_type"
                echo "Available types: tester-list, tester-group, release-note, test-device, test-password"
                exit 1
                ;;
        esac
    else
        # Show all files
        show_files "tester-list"
        echo
        show_files "tester-group"
        echo
        show_files "release-note"
        echo
        show_files "test-device"
        echo
        show_files "test-password"
    fi
}

# Function to edit a file
edit_file() {
    local file_type="$1"
    local file_path=""

    case "$file_type" in
        tester-list)
            file_path="$TESTER_LIST_FILE"
            ;;
        tester-group)
            file_path="$TESTER_GROUP_FILE"
            ;;
        release-note)
            file_path="$RELEASE_NOTE_FILE"
            ;;
        test-device)
            file_path="$TEST_DEVICE_FILE"
            ;;
        test-password)
            file_path="$TEST_PASSWORD_FILE"
            ;;
        *)
            log_error "Unknown file type: $file_type"
            echo "Available types: tester-list, tester-group, release-note, test-device, test-password"
            exit 1
            ;;
    esac

    ensure_distribution_dir

    if [[ ! -f "$file_path" ]]; then
        log_warning "File not found: $file_path"
        read -p "Create it now? (y/N) " -r
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            init_distribution_files
        else
            exit 0
        fi
    fi

    # Use the default editor (nano, vim, or $EDITOR)
    if [[ -n "$EDITOR" ]]; then
        "$EDITOR" "$file_path"
    elif command -v nano >/dev/null 2>&1; then
        nano "$file_path"
    elif command -v vim >/dev/null 2>&1; then
        vim "$file_path"
    else
        log_error "No text editor found. Please set EDITOR environment variable or install nano/vim"
        exit 1
    fi

    log_success "File updated: $file_path"
}

# Function to add a tester
add_tester() {
    local email="$1"

    if [[ -z "$email" ]]; then
        log_error "Email address is required"
        exit 1
    fi

    # Simple email validation
    if [[ ! "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
        log_error "Invalid email format: $email"
        exit 1
    fi

    ensure_distribution_dir

    if [[ ! -f "$TESTER_LIST_FILE" ]]; then
        init_distribution_files
    fi

    # Check if email already exists
    if grep -q "^$email$" "$TESTER_LIST_FILE" 2>/dev/null; then
        log_warning "Email already exists in tester list: $email"
        exit 0
    fi

    echo "$email" >> "$TESTER_LIST_FILE"
    log_success "Added tester: $email"
}

# Function to add a group
add_group() {
    local group="$1"

    if [[ -z "$group" ]]; then
        log_error "Group name is required"
        exit 1
    fi

    ensure_distribution_dir

    if [[ ! -f "$TESTER_GROUP_FILE" ]]; then
        init_distribution_files
    fi

    # Check if group already exists
    if grep -q "^$group$" "$TESTER_GROUP_FILE" 2>/dev/null; then
        log_warning "Group already exists in tester group list: $group"
        exit 0
    fi

    echo "$group" >> "$TESTER_GROUP_FILE"
    log_success "Added group: $group"
}

# Function to validate files
validate_files() {
    log_step "Validating distribution data files..."

    local errors=0

    # Validate tester list
    if [[ -f "$TESTER_LIST_FILE" ]]; then
        local invalid_emails=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Skip comments and empty lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ "$line" =~ ^[[:space:]]*$ ]] && continue

            if [[ ! "$line" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
                log_warning "Invalid email in tester list: $line"
                ((invalid_emails++))
            fi
        done < "$TESTER_LIST_FILE"

        if [[ $invalid_emails -eq 0 ]]; then
            log_success "Tester list validation passed"
        else
            log_error "Found $invalid_emails invalid email(s) in tester list"
            ((errors++))
        fi
    else
        log_warning "Tester list file not found: $TESTER_LIST_FILE"
    fi

    if [[ $errors -eq 0 ]]; then
        log_success "All validation checks passed!"
    else
        log_error "Validation failed with $errors error(s)"
        exit 1
    fi
}

# Main function
main() {
    local command="$1"
    shift || true

    case "$command" in
        init)
            init_distribution_files
            ;;
        show)
            show_files "$1"
            ;;
        edit)
            edit_file "$1"
            ;;
        add-tester)
            add_tester "$1"
            ;;
        add-group)
            add_group "$1"
            ;;
        validate)
            validate_files
            ;;
        --help|-h|help)
            show_usage
            ;;
        *)
            if [[ -z "$command" ]]; then
                log_error "No command specified"
            else
                log_error "Unknown command: $command"
            fi
            echo
            show_usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
</file>

