        log_success "  Firebase project: $FIREBASE_PROJECT"
    else
        log_warning "  Firebase project not configured for $FLAVOR"
    fi
done

echo
log_step "Setup Summary"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
