  final bool isDense;

  const DTextField({
    super.key,
    required this.controller,
    this.label = '',
    this.hint = '',
    this.inputStyle,
    this.labelStyle,
    this.hintStyle,
    this.errorStyle,
    this.contentPadding,
    this.cursorColor,
    this.border,
    this.enabledBorder,
    this.disabledBorder,
    this.focusedBorder,
    this.errorBorder,
    this.focusedErrorBorder,
    this.fillColor,
    this.customDateFormat = 'dd/MM/yyyy',
    this.prefix,
    this.suffix,
    this.requiredField = false,
    this.readOnly = false,
    this.expandFlex = 0,
    this.width = 0,
    this.onEditingComplete,
