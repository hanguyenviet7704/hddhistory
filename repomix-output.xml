# Function to add testers
add_testers() {
    if [[ ${#EMAILS[@]} -eq 0 ]]; then
        log_error "No emails provided"
        show_usage
        exit 1
    fi
    
    log_step "Adding testers to project..."
    log_info "Testers to add: ${EMAILS[*]}"
    
    local cmd="firebase appdistribution:testers:add"
    
    # Add emails
    for email in "${EMAILS[@]}"; do
        cmd="$cmd \"$email\""
