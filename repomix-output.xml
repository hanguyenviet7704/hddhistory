  void showDMaterialBanner({
    String message = '',
    Widget? messageWidget,
    MessageType type = MessageType.normal,
    Duration duration = const Duration(milliseconds: 1500),
    SnackBarAction? action,
    EdgeInsetsGeometry? margin,
