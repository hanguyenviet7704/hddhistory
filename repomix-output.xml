# Example: fix/ARTLEXIS-456-validation-error

# Release branches
RELEASE_PREFIX=release/
# Format: release/VERSION
# Example: release/1.2.0

# Hotfix branches (for critical production bugs)
HOTFIX_PREFIX=hotfix/
# Format: hotfix/TICKET-ID-description
# Example: hotfix/ARTLEXIS-789-payment-crash

# Version tag prefix
VERSION_TAG_PREFIX=v
# Example: v1.2.0

# Commit message format
# type(scope): subject
# OR
# type-TICKET-ID-description: subject
#
# Valid types:
# - feature: New feature
# - fix: Bug fix
# - hotfix: Critical bug fix
# - release: Release preparation
# - docs: Documentation changes
# - style: Code style changes (formatting, etc.)
# - refactor: Code refactoring
# - test: Test additions or modifications
# - chore: Maintenance tasks

# Branch protection rules
PROTECTED_BRANCHES=(main develop)

# Merge options
MERGE_NO_FF=true  # Always create merge commits
DELETE_BRANCH_ON_MERGE=true  # Delete feature branches after merge (local only)

# Validation rules
REQUIRE_TICKET_ID=true  # Require ticket ID in branch names
VALIDATE_COMMIT_MSG=true  # Validate commit message format
RUN_TESTS_BEFORE_PUSH=true  # Run tests before allowing push

# Team workflow settings
REQUIRE_CODE_REVIEW=true  # Require code review before merge
AUTO_CREATE_PR=false  # Automatically create PR when pushing feature branch
</file>

<file path="tools/macos/git/commit-helper.sh">
#!/bin/bash

# Commit Message Helper for GitFlow

# Navigate to the root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${SCRIPT_DIR}/../../.."
cd "${ROOT_DIR}" || {
    echo "❌ Failed to navigate to the project root directory."
    exit 1
}

# Color codes
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Get current branch
CURRENT_BRANCH=$(git branch --show-current)

# Extract ticket ID from branch
TICKET_ID=""
if [[ "$CURRENT_BRANCH" =~ ([A-Z]+-[0-9]+) ]]; then
    # Get the last ticket ID if multiple exist
    TICKET_ID=$(echo "$CURRENT_BRANCH" | grep -oE '[A-Z]+-[0-9]+' | tail -1)
fi

# Get branch type
BRANCH_TYPE=""
if [[ "$CURRENT_BRANCH" =~ ^(feature|fix|release|hotfix)/ ]]; then
    BRANCH_TYPE="${BASH_REMATCH[1]}"
fi

# Function to analyze staged files
analyze_staged_files() {
    local files=$(git diff --cached --name-only)
    local scope=""
    
    if [[ -z "$files" ]]; then
        echo "No staged files found."
        return 1
    fi
    
    # Determine scope based on file paths
    if echo "$files" | grep -q "lib/src/presentation/blocs/"; then
        scope="bloc"
    elif echo "$files" | grep -q "lib/src/presentation/pages/"; then
        scope="ui"
    elif echo "$files" | grep -q "lib/src/presentation/widgets/"; then
        scope="widget"
    elif echo "$files" | grep -q "lib/config/routes/"; then
        scope="routing"
    elif echo "$files" | grep -q "lib/src/data/"; then
        scope="data"
    elif echo "$files" | grep -q "lib/src/domain/"; then
        scope="domain"
    fi
    
    echo "$scope"
}

# Display header
clear
echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║              ${CYAN}Commit Message Helper${BLUE}                          ║${NC}"
echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Show current context
echo -e "${GREEN}📍 Current Context:${NC}"
echo -e "  Branch: ${CYAN}$CURRENT_BRANCH${NC}"
if [[ -n "$TICKET_ID" ]]; then
    echo -e "  Ticket: ${CYAN}$TICKET_ID${NC}"
fi
if [[ -n "$BRANCH_TYPE" ]]; then
    echo -e "  Type: ${CYAN}$BRANCH_TYPE${NC}"
fi
echo ""

# Show staged files
echo -e "${GREEN}📄 Staged Files:${NC}"
git diff --cached --name-only | head -10 | sed 's/^/  /'
if [[ $(git diff --cached --name-only | wc -l) -gt 10 ]]; then
    echo "  ... and $(($(git diff --cached --name-only | wc -l) - 10)) more files"
fi
echo ""

# Get scope from staged files
SCOPE=$(analyze_staged_files)

# Generate commit message suggestions
echo -e "${GREEN}💡 Suggested Commit Messages:${NC}"
echo ""

if [[ -n "$TICKET_ID" ]]; then
    echo -e "${YELLOW}With ticket ID:${NC}"
    echo "  $BRANCH_TYPE-$TICKET_ID: <description>"
    
    if [[ -n "$SCOPE" ]]; then
        echo "  $BRANCH_TYPE($SCOPE)-$TICKET_ID: <description>"
    fi
    echo ""
fi

echo -e "${YELLOW}With scope:${NC}"
if [[ -n "$SCOPE" ]]; then
    echo "  $BRANCH_TYPE($SCOPE): <description>"
else
    echo "  $BRANCH_TYPE(<scope>): <description>"
fi
echo ""

echo -e "${GREEN}📝 Examples based on your changes:${NC}"

# Provide context-specific examples
if echo "$(git diff --cached --name-only)" | grep -q "color_picker"; then
    echo "  ${BRANCH_TYPE}-${TICKET_ID}: Implement color picker functionality"
    echo "  ${BRANCH_TYPE}(gallery): Add color picker to gallery view"
fi

if echo "$(git diff --cached --name-only)" | grep -q "gallery"; then
    echo "  ${BRANCH_TYPE}-${TICKET_ID}: Update gallery view components"
    echo "  ${BRANCH_TYPE}(ui): Enhance gallery picture view"
fi

if echo "$(git diff --cached --name-only)" | grep -q "route"; then
    echo "  ${BRANCH_TYPE}-${TICKET_ID}: Add routing for color picker"
    echo "  ${BRANCH_TYPE}(routing): Configure color picker routes"
fi

if echo "$(git diff --cached --name-only)" | grep -q "bloc\|cubit\|state"; then
    echo "  ${BRANCH_TYPE}-${TICKET_ID}: Add state management for color picker"
    echo "  ${BRANCH_TYPE}(bloc): Implement color picker cubit"
fi

echo ""
echo -e "${BLUE}📋 Remember:${NC}"
echo "  • Use imperative mood: 'Add' not 'Added'"
echo "  • Keep under 50 characters"
echo "  • Be specific and descriptive"
echo "  • No period at the end"
echo ""

# Interactive mode
echo -e "${GREEN}🎯 Generate commit message? (y/n)${NC}"
read -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}Enter your commit description:${NC}"
    read -p "> " description
    
    if [[ -n "$TICKET_ID" ]]; then
        COMMIT_MSG="$BRANCH_TYPE-$TICKET_ID: $description"
    else
        COMMIT_MSG="$BRANCH_TYPE: $description"
    fi
    
    echo ""
    echo -e "${GREEN}Generated commit message:${NC}"
    echo -e "${CYAN}$COMMIT_MSG${NC}"
    echo ""
    echo -e "${YELLOW}Copy to clipboard? (y/n)${NC}"
    read -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "$COMMIT_MSG" | pbcopy
        echo -e "${GREEN}✅ Copied to clipboard!${NC}"
    fi
fi
</file>

<file path="tools/macos/git/feature.sh">
#!/bin/bash

# Navigate to the root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${SCRIPT_DIR}/../../.."
cd "${ROOT_DIR}" || {
    echo "❌ Failed to navigate to the project root directory."
    exit 1
}

# Source utilities
source "${SCRIPT_DIR}/utils.sh"

# Function to display usage
show_usage() {
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start <ticket-id> <description>  Start a new feature branch"
    echo "  finish                           Finish current feature branch"
    echo "  publish                          Push feature branch to remote"
    echo "  list                             List all feature branches"
    echo "  help                             Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0 start TG-123 login-social"
    echo "  $0 finish"
    echo "  $0 publish"
}

# Handle commands
case "$1" in
    start)
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "❌ Error: Missing ticket ID or description"
            echo "Usage: $0 start <ticket-id> <description>"
            exit 1
        fi
        
        TICKET_ID="$2"
        DESCRIPTION="$3"
        BRANCH_NAME="feature/${TICKET_ID}-${DESCRIPTION}"
        
        echo "🚀 Starting new feature: $BRANCH_NAME"
        
        # Ensure we're on develop and up to date
        git checkout develop
        git pull origin develop
        
        # Create and checkout new feature branch
        git checkout -b "$BRANCH_NAME"
        
        echo "✅ Feature branch created: $BRANCH_NAME"
        echo "💡 You can now start working on your feature"
        ;;
        
    finish)
        # Get current branch
        CURRENT_BRANCH=$(git branch --show-current)
        
        if [[ ! "$CURRENT_BRANCH" =~ ^feature/ ]]; then
            echo "❌ Error: Not on a feature branch"
            echo "Current branch: $CURRENT_BRANCH"
            exit 1
        fi
        
        echo "🏁 Finishing feature: $CURRENT_BRANCH"
        
        # Check if there are uncommitted changes
        check_clean_working_tree
        
        # Extract ticket ID from branch name
        TICKET_ID=$(extract_ticket_id "$CURRENT_BRANCH")
        
        # Make sure develop is up to date
        git fetch origin develop
        
        # Push current branch to remote if it's not already there
        if ! branch_exists_remote "$CURRENT_BRANCH"; then
            echo "📤 Pushing feature branch to remote..."
            git push -u origin "$CURRENT_BRANCH"
        else
            echo "📝 Feature branch already exists on remote"
            
            # Make sure local branch is up to date with remote
            echo "🔄 Updating local branch from remote..."
            git pull origin "$CURRENT_BRANCH"
        fi
        
        # Create PR/MR title based on branch name
        BRANCH_DESCRIPTION=$(echo "$CURRENT_BRANCH" | sed -E 's/^feature\/[A-Z]+-[0-9]+-(.+)/\1/')
        PR_TITLE="feature-${TICKET_ID}: $(echo $BRANCH_DESCRIPTION | tr '-' ' ' | sed 's/\b\(.\)/\u\1/g')"
        
        # Create pull request
        echo "🔗 Creating pull request..."
        create_pull_request "$CURRENT_BRANCH" "develop" "$PR_TITLE"
        
        echo "✅ Feature completed and pull request created!"
        echo "💡 After the pull request is approved and merged, you can delete your local branch with:"
        echo "   git branch -d $CURRENT_BRANCH"
        ;;
        
    publish)
        # Get current branch
        CURRENT_BRANCH=$(git branch --show-current)
        
        if [[ ! "$CURRENT_BRANCH" =~ ^feature/ ]]; then
            echo "❌ Error: Not on a feature branch"
            echo "Current branch: $CURRENT_BRANCH"
            exit 1
        fi
        
        echo "📤 Publishing feature: $CURRENT_BRANCH"
        git push -u origin "$CURRENT_BRANCH"
        
        echo "✅ Feature published to remote"
        echo "💡 You can now create a merge request on GitLab/GitHub"
        ;;
        
    list)
        echo "📋 Feature branches:"
        git branch -a | grep "feature/" | sed 's/remotes\/origin\///'  | sort | uniq
        ;;
        
    help|--help|-h)
        show_usage
        ;;
        
    *)
        echo "❌ Unknown command: $1"
        show_usage
        exit 1
        ;;
esac
</file>

