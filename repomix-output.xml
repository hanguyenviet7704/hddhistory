            --ipa)
                custom_ipa_path="$2"
                shift 2
                ;;
            --method)
                distribution_method="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            -h|--help)
                show_usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                show_usage
                exit 1
                ;;
        esac
    done
    
    # Validate distribution method
    if [[ "$distribution_method" != "firebase" && "$distribution_method" != "testflight" && "$distribution_method" != "both" ]]; then
        log_error "Invalid distribution method: $distribution_method"
        log_info "Valid methods are: firebase, testflight, both"
        exit 1
    fi
    
    # Validate required arguments
    if [[ -z "$flavor" ]]; then
        log_error "Missing required flavor argument"
        show_usage
        exit 1
    fi
    
    # Validate flavor using centralized function
    if ! validate_flavor "$flavor"; then
        exit 1
    fi
    
    # Show configuration summary
    show_config_summary "$flavor" "ios"
    
    # Navigate to root directory
    cd "$PROJECT_ROOT" || {
        log_error "Failed to navigate to the project root directory."
        exit 1
    }
    
    # Check prerequisites
    check_prerequisites
    
    # Build first if requested
    if [[ "$should_build" == true ]]; then
        log_step "Building IPA for $flavor flavor..."
        
        # Determine export method based on distribution method
        local export_method="app-store"  # Default for TestFlight
        if [[ "$distribution_method" == "firebase" ]]; then
            export_method="ad-hoc"
        elif [[ "$distribution_method" == "both" ]]; then
            # For both, we need to build twice (different export methods)
            log_warning "Building for both Firebase and TestFlight requires two builds with different export methods"
            
            # Build for Firebase first (ad-hoc)
            log_info "Building ad-hoc version for Firebase..."
            local firebase_build_cmd="$BUILD_TOOLS_DIR/build_ipa.sh $flavor --export-method ad-hoc"
            
            if [[ "$dry_run" == true ]]; then
                log_info "[DRY RUN] Would execute: $firebase_build_cmd"
            else
                log_step "Executing Firebase build command:"
                echo "${CYAN}$firebase_build_cmd${NC}"
                
                if ! $firebase_build_cmd; then
                    log_error "Firebase build failed!"
                    exit 1
                fi
                
                # Save the ad-hoc IPA path
                local ipa_output_dir=$(get_output_path "ios" "ipa" 2>/dev/null || echo "build/ios/ipa")
                local firebase_ipa_path=$(find "$ipa_output_dir" -name "*.ipa" -type f 2>/dev/null | head -n 1)
            fi
            
            # Build for TestFlight (app-store)
            log_info "Building app-store version for TestFlight..."
            export_method="app-store"
        fi
        
        local build_cmd="$BUILD_TOOLS_DIR/build_ipa.sh $flavor --export-method $export_method"
        
        if [[ "$dry_run" == true ]]; then
            log_info "[DRY RUN] Would execute: $build_cmd"
        else
            log_step "Executing build command:"
            echo "${CYAN}$build_cmd${NC}"
            
            if ! $build_cmd; then
                log_error "Build failed!"
                exit 1
            fi
        fi
    fi
    
    # Determine IPA path
    local ipa_path
    if [[ -n "$custom_ipa_path" ]]; then
        ipa_path="$custom_ipa_path"
    else
        # Use default build output path from centralized config
        local ipa_output_dir=$(get_output_path "ios" "ipa" 2>/dev/null || echo "build/ios/ipa")
        
        # Determine the expected IPA filename based on flavor
        # For prod, look for files without flavor suffix first (e.g., "Artlexis.ipa")
        # For dev/stg, look for files with flavor suffix (e.g., "Artlexis Dev.ipa", "Artlexis Stg.ipa")
        local expected_patterns=()
        if [[ "$flavor" == "prod" ]]; then
            # For production, prioritize files without flavor suffix
            expected_patterns=("Artlexis.ipa" "artlexis.ipa" "*prod*.ipa" "*Prod*.ipa")
        elif [[ "$flavor" == "dev" ]]; then
            expected_patterns=("*Dev.ipa" "*dev.ipa" "Artlexis Dev.ipa")
        elif [[ "$flavor" == "stg" ]]; then
            expected_patterns=("*Stg.ipa" "*stg.ipa" "*Staging.ipa" "Artlexis Stg.ipa")
        fi
        
        # Try to find the IPA file with the expected pattern
        for pattern in "${expected_patterns[@]}"; do
            ipa_path=$(find "$ipa_output_dir" -name "$pattern" -type f 2>/dev/null | head -n 1)
            if [[ -n "$ipa_path" && -f "$ipa_path" ]]; then
                log_info "Found matching IPA for $flavor: $(basename "$ipa_path")"
                break
            fi
        done
        
        # If no flavor-specific IPA found, try generic patterns
        if [[ -z "$ipa_path" || ! -f "$ipa_path" ]]; then
            # Try specific flavor-based name
            ipa_path="$ipa_output_dir/app-$flavor.ipa"
            
            if [[ ! -f "$ipa_path" ]]; then
                # For production, avoid selecting dev/stg files
                if [[ "$flavor" == "prod" ]]; then
                    # Find any .ipa but exclude dev and stg versions
                    ipa_path=$(find "$ipa_output_dir" -name "*.ipa" -type f 2>/dev/null | grep -v -i "dev\|stg\|staging" | head -n 1)
                else
                    # For dev/stg, just find any .ipa
                    ipa_path=$(find "$ipa_output_dir" -name "*.ipa" -type f 2>/dev/null | head -n 1)
                fi
                
                if [[ -z "$ipa_path" || ! -f "$ipa_path" ]]; then
                    # Try Runner.app for direct distribution
                    ipa_path="build/ios/iphoneos/Runner.app"
                    
                    if [[ ! -e "$ipa_path" ]]; then
                        log_error "IPA file not found in $ipa_output_dir"
                        log_info "Please specify path with --ipa or build first with --build-first"
                        
                        # Show available IPA files for debugging
                        local available_ipas=$(find "$ipa_output_dir" -name "*.ipa" -type f 2>/dev/null)
                        if [[ -n "$available_ipas" ]]; then
                            log_warning "Available IPA files:"
                            echo "$available_ipas" | while read -r file; do
                                echo "  - $(basename "$file")"
                            done
                            log_info "Consider using --ipa <path> to specify the correct file"
                        fi
                        exit 1
                    fi
                fi
            fi
        fi
    fi
    
    # Check if file exists before distribution
    if [[ ! -f "$ipa_path" && ! -d "$ipa_path" ]]; then
        log_error "Build file not found: $ipa_path"
        log_info "Please build the IPA first or use --build-first option"
        exit 1
    fi
    
    log_info "Found build file: $ipa_path"
    if [[ -f "$ipa_path" ]]; then
        log_info "File size: $(du -h "$ipa_path" | cut -f1)"
    fi
    
    if [[ "$dry_run" == true ]]; then
        log_warning "[DRY RUN MODE] - Commands will be shown but not executed"
        exit 0
    fi
    
    # Distribute based on selected method
    local distribution_success=true
    
    case "$distribution_method" in
        firebase)
            if ! distribute_to_firebase "$ipa_path" "$flavor" "IPA"; then
                distribution_success=false
            fi
            ;;
        testflight)
            if ! distribute_to_testflight "$ipa_path" "$flavor"; then
                distribution_success=false
            fi
            ;;
        both)
            # Distribute to Firebase first (using ad-hoc build)
            if [[ -n "$firebase_ipa_path" ]]; then
                log_step "Distributing to Firebase..."
                if ! distribute_to_firebase "$firebase_ipa_path" "$flavor" "IPA"; then
                    distribution_success=false
                fi
            fi
            
            # Then distribute to TestFlight (using app-store build)
            echo ""
            log_step "Distributing to TestFlight..."
            if ! distribute_to_testflight "$ipa_path" "$flavor"; then
                distribution_success=false
            fi
            ;;
    esac
    
    if [[ "$distribution_success" == true ]]; then
        log_success "🎉 Distribution completed successfully!"
    else
        log_error "Distribution failed or completed with errors"
        exit 1
    fi
    
    # Show next steps based on distribution method
    echo ""
    log_info "Next steps:"
    
    if [[ "$distribution_method" == "firebase" || "$distribution_method" == "both" ]]; then
        echo "  📱 Firebase App Distribution:"
        echo "     - Check console: https://console.firebase.google.com/project/$PROJECT_ID/appdistribution"
        echo "     - Testers will receive email invitations"
        echo "     - Monitor installation and feedback"
    fi
    
    if [[ "$distribution_method" == "testflight" || "$distribution_method" == "both" ]]; then
        if [[ "$distribution_method" == "both" ]]; then
            echo ""
        fi
        echo "  ✈️  TestFlight:"
        echo "     - Check App Store Connect: https://appstoreconnect.apple.com"
        echo "     - Add testers in TestFlight"
        echo "     - Submit for external testing (if needed)"
    fi
}

# Run main function with all arguments
main "$@"
</file>

<file path="tools/macos/distribution/distribute.sh">
#!/bin/bash

# Enable strict error handling
set -e

# Define directory structure with clean paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
ROOT_DIR="$(cd "${TOOLS_DIR}/.." && pwd)"

# Use clean path references
MACOS_TOOLS_DIR="${TOOLS_DIR}/macos"
DISTRIBUTION_DIR="${MACOS_TOOLS_DIR}/distribution"
FIREBASE_INFO_FILE="${ROOT_DIR}/.info/firebase_info.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored output
print_info() { echo -e "${BLUE}ℹ️  $1${NC}"; }
print_success() { echo -e "${GREEN}✅ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }
print_error() { echo -e "${RED}❌ $1${NC}"; }

# Function to show usage
show_usage() {
    echo "🚀 Firebase App Distribution - Universal Tool"
    echo ""
    echo "Usage: $(basename "$0") [platform] [build_type] [flavor] [options]"
    echo ""
    echo "Arguments:"
    echo "  platform:     android, ios, or both"
    echo "  build_type:   For Android: apk, appbundle, or both"
    echo "                For iOS: ipa"
    echo "  flavor:       dev, stg, or prod"
    echo ""
    echo "Options:"
    echo "  build_first   Build before distributing"
    echo "  file_path     Specific path to build file (for single file distribution)"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") android apk dev build_first          # Build and distribute APK for dev"
    echo "  $(basename "$0") ios ipa prod                         # Distribute existing IPA for prod"
    echo "  $(basename "$0") both both stg build_first            # Build and distribute all formats for staging"
    echo "  $(basename "$0") android appbundle dev path/to.aab    # Distribute specific App Bundle"
    echo ""
    echo "Quick Commands:"
    echo "  $(basename "$0") quick-dev      # Build and distribute APK for dev (quick testing)"
    echo "  $(basename "$0") quick-stg      # Build and distribute App Bundle for staging"
    echo "  $(basename "$0") quick-prod     # Build and distribute both platforms for production"
}

# Function to check if Firebase info is configured
check_firebase_config() {
    if [[ ! -f "$FIREBASE_INFO_FILE" ]]; then
        print_error "Firebase configuration not found!"
        print_info "Please run the setup script first:"
        print_info "  $DISTRIBUTION_DIR/setup_firebase.sh"
        exit 1
    fi
    
    # Check if it's still using placeholder values
    local project_id=$(jq -r '.projectId' "$FIREBASE_INFO_FILE")
    if [[ "$project_id" == "your-firebase-project-id" ]]; then
        print_warning "Firebase configuration contains placeholder values."
        print_info "Please update .info/firebase_info.json with your actual Firebase project information."
        print_info "Or run the setup script: $DISTRIBUTION_DIR/setup_firebase.sh"
        exit 1
    fi
}

# Function to distribute Android
distribute_android() {
    local build_type="$1"
    local flavor="$2"
    local should_build="$3"
    local file_path="$4"
    
    print_info "📱 Starting Android distribution..."
    
    if [[ "$build_type" == "both" ]]; then
        # Distribute both APK and App Bundle
        print_info "Distributing both APK and App Bundle..."
        
        "$DISTRIBUTION_DIR/distribute_android.sh" "apk" "$flavor" "$should_build"
        if [[ $? -eq 0 ]]; then
            print_success "APK distribution completed!"
        else
            print_error "APK distribution failed!"
            return 1
        fi
        
        "$DISTRIBUTION_DIR/distribute_android.sh" "appbundle" "$flavor" "$should_build"
        if [[ $? -eq 0 ]]; then
            print_success "App Bundle distribution completed!"
        else
            print_error "App Bundle distribution failed!"
            return 1
        fi
    else
        # Distribute specific build type
        if [[ -n "$file_path" ]]; then
            # TODO: Implement specific file path handling
            print_warning "Specific file path not yet implemented for Android script"
        fi
        
        "$DISTRIBUTION_DIR/distribute_android.sh" "$build_type" "$flavor" "$should_build"
        if [[ $? -eq 0 ]]; then
            print_success "Android distribution completed!"
        else
            print_error "Android distribution failed!"
            return 1
        fi
    fi
}

# Function to distribute iOS
distribute_ios() {
    local flavor="$1"
    local should_build="$2"
    local file_path="$3"
    
    print_info "🍎 Starting iOS distribution..."
    
    local args=("$flavor")
    
    if [[ -n "$should_build" ]]; then
        args+=("$should_build")
    fi
    
    if [[ -n "$file_path" ]]; then
        args+=("$file_path")
    fi
    
    "$DISTRIBUTION_DIR/distribute_ios.sh" "${args[@]}"
    if [[ $? -eq 0 ]]; then
        print_success "iOS distribution completed!"
    else
        print_error "iOS distribution failed!"
        return 1
    fi
}

# Function to handle quick commands
handle_quick_command() {
    local command="$1"
    
    case "$command" in
        "quick-dev")
            print_info "🚀 Quick Dev Distribution (APK only)"
            distribute_android "apk" "dev" "build_first"
            ;;
        "quick-stg")
            print_info "🚀 Quick Staging Distribution (App Bundle)"
            distribute_android "appbundle" "stg" "build_first"
            ;;
        "quick-prod")
            print_info "🚀 Quick Production Distribution (Both platforms)"
            distribute_android "appbundle" "prod" "build_first"
            if [[ $? -eq 0 && "$(uname)" == "Darwin" ]]; then
                distribute_ios "prod" "build_first"
            fi
            ;;
        *)
            print_error "Unknown quick command: $command"
            show_usage
            exit 1
            ;;
    esac
}

# Main function
main() {
    # Check for quick commands first
    if [[ $# -eq 1 && "$1" =~ ^quick- ]]; then
        check_firebase_config
        handle_quick_command "$1"
        return $?
    fi
    
    # Check arguments
    if [[ $# -lt 3 ]]; then
        show_usage
        exit 1
    fi
    
    local platform="$1"
    local build_type="$2"
    local flavor="$3"
    local should_build="$4"
    local file_path="$5"
    
    # Validate platform
    if [[ "$platform" != "android" && "$platform" != "ios" && "$platform" != "both" ]]; then
        print_error "Invalid platform. Use 'android', 'ios', or 'both'"
        exit 1
    fi
    
    # Validate flavor
    if [[ "$flavor" != "dev" && "$flavor" != "stg" && "$flavor" != "prod" ]]; then
        print_error "Invalid flavor. Use 'dev', 'stg', or 'prod'"
        exit 1
    fi
    
    # Navigate to root directory
    cd "$ROOT_DIR" || {
        print_error "Failed to navigate to the project root directory."
        exit 1
    }
    
    # Check Firebase configuration
    check_firebase_config
    
    print_info "🚀 Starting Firebase App Distribution"
    print_info "Platform: $platform | Build Type: $build_type | Flavor: $flavor"
    
    # Handle distribution based on platform
    case "$platform" in
        "android")
            if [[ "$build_type" != "apk" && "$build_type" != "appbundle" && "$build_type" != "both" ]]; then
                print_error "Invalid build type for Android. Use 'apk', 'appbundle', or 'both'"
                exit 1
            fi
            distribute_android "$build_type" "$flavor" "$should_build" "$file_path"
            ;;
        "ios")
            if [[ "$build_type" != "ipa" ]]; then
                print_error "Invalid build type for iOS. Use 'ipa'"
                exit 1
            fi
            distribute_ios "$flavor" "$should_build" "$file_path"
            ;;
        "both")
            # Distribute Android first
            local android_build_type="$build_type"
            if [[ "$build_type" == "both" ]]; then
                android_build_type="both"
            elif [[ "$build_type" == "ipa" ]]; then
                android_build_type="appbundle"  # Default to App Bundle for production
            fi
            
            distribute_android "$android_build_type" "$flavor" "$should_build"
            
            # Distribute iOS if on macOS
            if [[ "$(uname)" == "Darwin" ]]; then
                distribute_ios "$flavor" "$should_build"
            else
                print_warning "Skipping iOS distribution (not running on macOS)"
            fi
            ;;
    esac
    
    if [[ $? -eq 0 ]]; then
        print_success "🎉 All distributions completed successfully!"
    else
        print_error "❌ Some distributions failed!"
        exit 1
    fi
}

# Run main function with all arguments
main "$@"
</file>

<file path="tools/macos/distribution/DISTRIBUTION_DATA_GUIDE.md">
# Distribution Data Files Guide

Quick reference for using distribution data files with Firebase App Distribution.

## 🎯 Quick Start

### 1. Initialize Data Files
```bash
./tools/macos/distribution/manage_distribution_data.sh init
```

### 2. Add Your Data

**Add Testers:**
```bash
# Method 1: Using command
./tools/macos/distribution/manage_distribution_data.sh add-tester user@example.com

# Method 2: Edit file directly
./tools/macos/distribution/manage_distribution_data.sh edit tester-list
```

**Add Groups:**
```bash
# Method 1: Using command
./tools/macos/distribution/manage_distribution_data.sh add-group qa-team

# Method 2: Edit file directly
./tools/macos/distribution/manage_distribution_data.sh edit tester-group
```

**Custom Release Notes:**
```bash
./tools/macos/distribution/manage_distribution_data.sh edit release-note
```

### 3. Validate
```bash
./tools/macos/distribution/manage_distribution_data.sh validate
```

### 4. Distribute
```bash
# Build and distribute with combined data
./tools/macos/build/build_apk.sh dev --distribute
```

## 📁 File Formats

### tester_list.txt
One email per line, comments with `#`:
```
# Dev Team
dev1@company.com
dev2@company.com

# QA Team
qa@company.com
```

### tester_group.txt
One group per line:
```
dev-team
qa-team
beta-testers
```

### release_note.txt
Markdown with variables:
```
Version {{version}} - {{flavor}}

Changes:
- New feature X
- Bug fix Y

Released: {{date}}
```

### test_device.txt
Format: `Name|DeviceID|Platform`
```
iPhone 14 Pro|00008110-001234567890001E|iOS
Pixel 7|emulator-5554|Android
```

### test_password.txt
Plain text password (add to `.gitignore`):
```
your-test-password
```

## 🔄 How It Works

### Data Combination

**Testers & Groups:**
1. Reads from `app/firebase.json` (permanent config)
2. Reads from `distribution/*.txt` (temporary/local)
3. Combines and removes duplicates
4. Uses in distribution

**Release Notes:**
1. Checks `distribution/release_note.txt` first
2. Falls back to `app/firebase.json` template
3. Replaces variables ({{version}}, {{flavor}}, {{date}})

### Priority

```
Text File Data + JSON Config = Final Distribution List
```

**Example:**
- JSON has: `["dev@company.com", "qa@company.com"]`
- Text file has: `temp-tester@company.com`
- Result: `["dev@company.com", "qa@company.com", "temp-tester@company.com"]`

## 💡 Use Cases

### 1. Temporary Tester
Add a tester for one build without modifying JSON:
```bash
echo "temp-tester@example.com" >> .info/distribution/tester_list.txt
./tools/macos/build/build_apk.sh dev --distribute
```

### 2. Custom Release Notes Per Build
```bash
cat > .info/distribution/release_note.txt <<EOF
Hotfix Build {{version}}

Critical Fixes:
- Fixed crash on startup
- Fixed payment issue

Build: {{date}}
EOF

./tools/macos/build/build_apk.sh prod --distribute
```

### 3. Local Testing Configuration
```bash
# Add your test devices (not in version control)
echo "My iPhone|device-id|iOS" >> .info/distribution/test_device.txt

# Set test password (not in version control)
echo "test123" > .info/distribution/test_password.txt

# Use in automated testing
devices=$(get_test_devices_from_file)
password=$(get_test_password_from_file)
```

### 4. Sync Groups to Firebase
```bash
# Edit groups
./tools/macos/distribution/manage_distribution_data.sh edit tester-group

# Sync to Firebase
./tools/macos/distribution/manage_distribution_data.sh sync-to-firebase --flavor dev
```

## 🛠️ Commands Reference

### Management Commands

| Command | Description |
|---------|-------------|
| `init` | Initialize all data files with templates |
| `show [file]` | Display file contents |
| `edit <file>` | Edit a specific file |
| `validate` | Validate all files |
| `add-tester <email>` | Add tester to list |
| `add-group <name>` | Add group to list |
| `add-device <info>` | Add test device |
| `set-password` | Set test password interactively |
| `set-release-note` | Set release notes from stdin |
| `sync-to-firebase --flavor <f>` | Sync data to Firebase |

### File Types

| File Type | File |
|-----------|------|
| `tester-list` | tester_list.txt |
| `tester-group` | tester_group.txt |
| `release-note` | release_note.txt |
| `test-device` | test_device.txt |
| `test-password` | test_password.txt |

## 📖 Integration Examples

### Shell Script Integration

```bash
#!/bin/bash

# Source common config
source tools/macos/common/common.sh

# Get combined testers
all_testers=$(get_all_testers "dev")
echo "Distributing to: $all_testers"

# Get combined groups
all_groups=$(get_all_groups "dev")
echo "Groups: $all_groups"

# Get release notes (text file or template)
notes=$(get_all_release_notes "dev" "1.0.0")
echo "Release notes: $notes"

# Get test configuration
devices=$(get_test_devices_from_file)
password=$(get_test_password_from_file)
```

### Distribution Flow

```bash
# 1. Update release notes for this build
cat > .info/distribution/release_note.txt <<EOF
Version {{version}} - Hotfix Release

Critical Fixes:
- Database migration issue
- Memory leak in image cache

Build: {{date}}
EOF

# 2. Add temporary beta tester
echo "beta-user@example.com" >> .info/distribution/tester_list.txt

# 3. Build and distribute
./tools/macos/build/build_apk.sh prod --distribute

# 4. Clean up temporary data
> .info/distribution/tester_list.txt
> .info/distribution/release_note.txt
```

### CI/CD Integration

```yaml
# GitHub Actions example
- name: Setup Distribution Data
  run: |
    # Initialize files
    ./tools/macos/distribution/manage_distribution_data.sh init
    
    # Add CI-specific testers
    echo "${{ secrets.CI_TESTER_EMAILS }}" >> .info/distribution/tester_list.txt
    
    # Set release notes from git log
    git log --oneline -5 > .info/distribution/release_note.txt

- name: Build and Distribute
  run: |
    ./tools/macos/build/build_apk.sh ${{ matrix.flavor }} --distribute
```

## ⚠️ Important Notes

### Security

1. **Never commit passwords:**
   ```gitignore
   .info/distribution/test_password.txt
   ```

2. **Sensitive tester emails:**
   - Use JSON for public/team emails
   - Use text files for sensitive/temporary emails
   - Add to `.gitignore` if needed

### Data Persistence

- **Text files** are local and build-specific
- **JSON config** is version-controlled and permanent
- Text files override/extend JSON config

### Validation

Always validate before distribution:
```bash
./tools/macos/distribution/manage_distribution_data.sh validate
```

## 🔍 Troubleshooting

### Testers Not Receiving Invites

```bash
# Check combined list
source tools/macos/common/common.sh
get_all_testers "dev"

# Validate email formats
./tools/macos/distribution/manage_distribution_data.sh validate
```

### Release Notes Not Showing

```bash
# Check if text file exists and has content
cat .info/distribution/release_note.txt

# Show processed notes
source tools/macos/common/common.sh
get_all_release_notes "dev" "1.0.0"
```

### Groups Not Syncing

```bash
# List configured groups
./tools/macos/distribution/manage_distribution_data.sh show tester-group

# Sync to Firebase
