              return UserListItem(
                user: users[index],
                onTap: (user) => _navigateToProfile(context, user),
              );
            },
          ),
          error: (exception) => ErrorDisplay(
            exception: exception,
            onRetry: () => context.read<UserListCubit>().refresh(),
          ),
        );
      },
    );
  }
  
  void _navigateToProfile(BuildContext context, User user) {
    // Navigate to user profile
  }
}
