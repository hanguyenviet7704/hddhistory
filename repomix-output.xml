  target_compile_features(${TARGET} PUBLIC cxx_std_17)
  target_compile_options(${TARGET} PRIVATE /W4 /WX /wd"4100")
  target_compile_options(${TARGET} PRIVATE /EHsc)
  target_compile_definitions(${TARGET} PRIVATE "_HAS_EXCEPTIONS=0")
  target_compile_definitions(${TARGET} PRIVATE "$<$<CONFIG:Debug>:_DEBUG>")
endfunction()

# Flutter library and tool build rules.
set(FLUTTER_MANAGED_DIR "${CMAKE_CURRENT_SOURCE_DIR}/flutter")
add_subdirectory(${FLUTTER_MANAGED_DIR})

# Application build; see runner/CMakeLists.txt.
add_subdirectory("runner")


# Generated plugin build rules, which manage building the plugins and adding
# them to the application.
include(flutter/generated_plugins.cmake)


# === Installation ===
# Support files are copied into place next to the executable, so that it can
# run in place. This is done instead of making a separate bundle (as on Linux)
# so that building and running from within Visual Studio will work.
set(BUILD_BUNDLE_DIR "$<TARGET_FILE_DIR:${BINARY_NAME}>")
# Make the "install" step default, as it's required to run.
set(CMAKE_VS_INCLUDE_INSTALL_TO_DEFAULT_BUILD 1)
if(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
  set(CMAKE_INSTALL_PREFIX "${BUILD_BUNDLE_DIR}" CACHE PATH "..." FORCE)
endif()

set(INSTALL_BUNDLE_DATA_DIR "${CMAKE_INSTALL_PREFIX}/data")
set(INSTALL_BUNDLE_LIB_DIR "${CMAKE_INSTALL_PREFIX}")

install(TARGETS ${BINARY_NAME} RUNTIME DESTINATION "${CMAKE_INSTALL_PREFIX}"
  COMPONENT Runtime)

install(FILES "${FLUTTER_ICU_DATA_FILE}" DESTINATION "${INSTALL_BUNDLE_DATA_DIR}"
  COMPONENT Runtime)

install(FILES "${FLUTTER_LIBRARY}" DESTINATION "${INSTALL_BUNDLE_LIB_DIR}"
  COMPONENT Runtime)

if(PLUGIN_BUNDLED_LIBRARIES)
  install(FILES "${PLUGIN_BUNDLED_LIBRARIES}"
    DESTINATION "${INSTALL_BUNDLE_LIB_DIR}"
    COMPONENT Runtime)
endif()

# Copy the native assets provided by the build.dart from all packages.
set(NATIVE_ASSETS_DIR "${PROJECT_BUILD_DIR}native_assets/windows/")
install(DIRECTORY "${NATIVE_ASSETS_DIR}"
   DESTINATION "${INSTALL_BUNDLE_LIB_DIR}"
   COMPONENT Runtime)

# Fully re-copy the assets directory on each build to avoid having stale files
# from a previous install.
set(FLUTTER_ASSET_DIR_NAME "flutter_assets")
install(CODE "
  file(REMOVE_RECURSE \"${INSTALL_BUNDLE_DATA_DIR}/${FLUTTER_ASSET_DIR_NAME}\")
  " COMPONENT Runtime)
install(DIRECTORY "${PROJECT_BUILD_DIR}/${FLUTTER_ASSET_DIR_NAME}"
  DESTINATION "${INSTALL_BUNDLE_DATA_DIR}" COMPONENT Runtime)

# Install the AOT library on non-Debug builds only.
install(FILES "${AOT_LIBRARY}" DESTINATION "${INSTALL_BUNDLE_DATA_DIR}"
  CONFIGURATIONS Profile;Release
  COMPONENT Runtime)
</file>

<file path=".cursorrules">
# Cursor Commit Message Generation Rules

## Commit Message Format
When generating commit messages, follow the GitFlow convention established in this project:

### Format Options:
Use the format: `type-TICKET-ID: subject` - Always include the ticket ID in the commit message

### Valid Types:
- `feature`: New feature implementation
- `fix`: Bug fixes
- `refactor`: Code refactoring without changing functionality
- `style`: Code style changes (formatting, naming, etc.)
- `docs`: Documentation changes
- `test`: Adding or modifying tests
- `chore`: Maintenance tasks, dependency updates
- `perf`: Performance improvements

### Commit Message Rules:
1. **Extract ticket ID from branch name**: 
   - For branch format `type/TICKET-ID-description`: Use `TICKET-ID`
   - For branch format `type/TICKET-ID/TICKET-ID-description`: Use the second `TICKET-ID`
   - For branch format `type/TICKET-ID/TICKET-ID`: Use the second `TICKET-ID`
2. **Use imperative mood**: "Add feature" not "Added feature"
3. **Keep subject line under 50 characters**
4. **Capitalize first letter of subject**
5. **No period at the end of subject line**
6. **Separate subject from body with blank line if body is needed**

### Examples based on file changes:
- For new features: `feature-ARTLEXIS-123: Add social login functionality`
- For bug fixes: `fix-ARTLEXIS-123: Correct email regex pattern`
- With ticket ID: `feature-TICKET-ID: Implement new functionality`
- For UI changes: `style-ARTLEXIS-123: Update gallery view layout`
- For state management: `feature-ARTLEXIS-123: Add new cubit`

### Context-Aware Examples:
When files are in specific directories, use appropriate scopes:
- `lib/src/presentation/blocs/*` → Use `bloc` or specific feature as scope
- `lib/src/presentation/pages/*` → Use `ui` or page name as scope
- `lib/src/presentation/widgets/*` → Use `widget` or component name as scope
- `lib/config/routes/*` → Use `routing` as scope

### For Current Branch:
- Check the current branch name pattern (typically `type/TICKET-ID/description` or `type/TICKET-ID-description`)
- Extract the ticket ID (e.g., `ARTLEXIS-123`) from the branch name
- Prefer format: `feature-TICKET-ID: <description>`

### Automated Suggestions:
Based on the staged files, suggest commits like:
1. For feature files: `feature-TICKET-ID: Add new functionality`
2. For UI/view files: `feature-TICKET-ID: Update UI components`
3. For routing files: `feature-TICKET-ID: Add new route`
4. For multiple related files: `feature-TICKET-ID: Implement complete feature`

## Additional Context
This project uses GitFlow workflow. Always ensure commit messages are descriptive and follow the established convention for better traceability and project history.
</file>

