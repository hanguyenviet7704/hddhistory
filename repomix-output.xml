    local batch_size=100
    local batch_count=0
    
    for ((i=0; i<${#emails[@]}; i+=batch_size)); do
        batch_count=$((batch_count + 1))
        local batch_emails=("${emails[@]:$i:$batch_size}")
        
        log_info "Processing batch $batch_count (${#batch_emails[@]} testers)"
        
