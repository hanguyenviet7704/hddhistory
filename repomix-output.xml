<file path="tools/windows/distribution/setup_firebase.bat">
@echo off
setlocal enabledelayedexpansion

REM Enhanced Firebase Setup Script for Windows
REM This script helps set up Firebase App Distribution configuration

REM Define directory structure with clean paths
set "SCRIPT_DIR=%~dp0"
for %%i in ("%SCRIPT_DIR%..\..\..") do set "ROOT_DIR=%%~fi"

REM Load common configuration functions
call "%SCRIPT_DIR%..\common\common.bat"
if %errorlevel% neq 0 (
    echo ❌ Failed to load common configuration library.
    echo Make sure tools\windows\common\common.bat exists and is readable.
    goto :end
)

REM Function to check prerequisites
call :check_prerequisites
if %errorlevel% neq 0 goto :end

REM Initialize variables
set "INTERACTIVE_MODE=true"

REM Parse command line arguments
:parse_args
if "%~1"=="" goto :args_done
if "%~1"=="--non-interactive" (
    set "INTERACTIVE_MODE=false"
    shift
    goto :parse_args
)
if "%~1"=="-h" goto :show_help
if "%~1"=="--help" goto :show_help

call :log_error "Unknown option: %~1"
goto :show_help

:show_help
echo Usage: %~nx0 [--non-interactive]
echo.
echo Options:
echo   --non-interactive     Run without user prompts (use existing config)
echo   -h, --help           Show this help message
echo.
echo This script helps set up Firebase App Distribution for the project.
echo It will guide you through configuring Firebase projects and app IDs.
echo.
echo Note: iOS configuration is not available on Windows.
goto :end

:args_done

call :log_step "🚀 Setting up Firebase App Distribution..."

REM Check Firebase login
call :firebase_login
if %errorlevel% neq 0 goto :end

REM Show available projects
call :list_firebase_projects

REM Get configuration for each flavor
call :log_step "Configuring Firebase projects for flavors..."

for %%f in (dev stg prod) do (
    echo.
    call :log_step "Configuring flavor: %%f"

    if "%INTERACTIVE_MODE%"=="true" (
        call :configure_flavor_interactive "%%f"
    ) else (
        call :configure_flavor_automatic "%%f"
    )

    if !errorlevel! neq 0 (
        call :log_warning "Failed to configure flavor: %%f"
    ) else (
        call :log_success "Flavor %%f configured successfully"
    )
)

REM Test configuration
echo.
call :log_step "Testing Firebase configuration..."
call :test_firebase_config

call :log_success "🎉 Firebase setup completed successfully!"
echo.
echo Your Firebase configuration is ready for use with distribution scripts.
echo.
echo Next steps:
echo   1. Build your app: tools\windows\build\build_apk.bat dev
echo   2. Distribute: tools\windows\distribution\distribute_android.bat apk dev
echo.

goto :end

REM ============================================
REM Helper Functions
REM ============================================

:check_prerequisites
call :log_step "Checking prerequisites..."

REM Check if Firebase CLI is installed
where firebase >nul 2>&1
if !errorlevel! neq 0 (
    call :log_error "Firebase CLI is not installed. Please install it first:"
    echo npm install -g firebase-tools
    exit /b 1
)

REM Check if jq is installed for JSON parsing
where jq >nul 2>&1
if !errorlevel! neq 0 (
    call :log_warning "jq is not installed. Some features may be limited."
    echo Download from: https://github.com/stedolan/jq/releases
) else (
    call :log_success "jq found - full JSON support available"
)

call :log_success "Firebase CLI found"
exit /b 0

:firebase_login
call :log_step "Checking Firebase authentication..."

firebase projects:list >nul 2>&1
if !errorlevel! neq 0 (
    call :log_step "Please login to Firebase..."
    firebase login
    if !errorlevel! neq 0 (
        call :log_error "Firebase login failed"
        exit /b 1
    )
) else (
    call :log_success "Already logged in to Firebase!"
)
exit /b 0

:list_firebase_projects
call :log_step "Available Firebase projects:"
firebase projects:list
exit /b 0

:configure_flavor_interactive
set "flavor=%~1"
call :log_info "Configuring %flavor% flavor..."

echo.
echo Please enter the Firebase project ID for %flavor% flavor:
set /p "project_id=Project ID: "

if "%project_id%"=="" (
    call :log_warning "No project ID provided for %flavor%, skipping..."
    exit /b 1
)

REM Validate project exists
call :validate_firebase_project "%project_id%"
if !errorlevel! neq 0 exit /b 1

REM Get Android app ID
echo.
echo Please enter the Android app ID for %flavor% flavor:
set /p "android_app_id=Android App ID: "

if "%android_app_id%"=="" (
    call :log_warning "No Android app ID provided for %flavor%"
)

REM Store configuration (this would update the JSON config file)
call :log_info "Configuration saved for %flavor%:"
echo   Project ID: %project_id%
echo   Android App ID: %android_app_id%

exit /b 0

:configure_flavor_automatic
set "flavor=%~1"
call :log_info "Using existing configuration for %flavor% flavor..."

call :get_firebase_project_id "%flavor%" existing_project
if "%existing_project%"=="" (
    call :log_warning "No existing configuration found for %flavor%"
    exit /b 1
)

call :log_success "Found existing configuration for %flavor%: %existing_project%"
exit /b 0

:validate_firebase_project
set "project_id=%~1"

call :log_info "Validating project: %project_id%"

firebase projects:list | findstr /c:"%project_id%" >nul
if %errorlevel% neq 0 (
    call :log_error "Project '%project_id%' not found in your Firebase account"
    exit /b 1
)

REM Set current project
firebase use "%project_id%" >nul 2>&1
if %errorlevel% neq 0 (
    call :log_error "Failed to set project '%project_id%'"
    exit /b 1
)

call :log_success "Project '%project_id%' validated successfully!"
exit /b 0

:test_firebase_config
call :log_info "Testing Firebase configuration..."

REM Test each configured flavor
for %%f in (dev stg prod) do (
    call :get_firebase_project_id "%%f" project_id
    if "!project_id!" neq "" (
        call :log_info "Testing %%f: !project_id!"
        firebase use "!project_id!" >nul 2>&1
        if !errorlevel! equ 0 (
            call :log_success "%%f configuration: OK"
        ) else (
            call :log_warning "%%f configuration: Failed"
        )
    ) else (
        call :log_warning "%%f: No configuration found"
    )
)

exit /b 0

:end
endlocal

REM Pause for user removed for automation
</file>

<file path="tools/windows/distribution/upload_playstore.bat">
@echo off
setlocal enabledelayedexpansion

REM Enhanced Google Play Store Upload Script for Windows
REM This script uploads Android App Bundles to Google Play Console

REM Define directory structure with clean paths
set "SCRIPT_DIR=%~dp0"
for %%i in ("%SCRIPT_DIR%..\..\..") do set "ROOT_DIR=%%~fi"

REM Load common configuration functions
call "%SCRIPT_DIR%..\common\common.bat"
if %errorlevel% neq 0 (
    echo ❌ Failed to load common configuration library.
    echo Make sure tools\windows\common\common.bat exists and is readable.
    goto :end
)

REM Initialize variables
set "FLAVOR="
set "BUILD_FIRST=false"
set "TRACK=internal"
set "SPECIFIC_FILE="

REM Parse command line arguments
:parse_args
if "%~1"=="" goto :args_done

if "%~1"=="dev" (
    set "FLAVOR=%~1"
    shift
    goto :parse_args
)
if "%~1"=="stg" (
    set "FLAVOR=%~1"
    shift
    goto :parse_args
)
if "%~1"=="prod" (
    set "FLAVOR=%~1"
    shift
    goto :parse_args
)
if "%~1"=="--build-first" (
    set "BUILD_FIRST=true"
    shift
    goto :parse_args
)
if "%~1"=="--track" (
    set "TRACK=%~2"
    shift
    shift
    goto :parse_args
)
if "%~1"=="--file" (
    set "SPECIFIC_FILE=%~2"
    shift
    shift
    goto :parse_args
)
if "%~1"=="-h" goto :show_help
if "%~1"=="--help" goto :show_help

call :log_error "Unknown option: %~1"
goto :show_help

:show_help
echo Usage: %~nx0 [dev^|stg^|prod] [options]
echo.
echo Arguments:
echo   dev^|stg^|prod           Build flavor (required)
echo.
echo Options:
echo   --build-first           Build App Bundle before uploading
echo   --track ^<name^>          Upload track (internal, alpha, beta, production) [default: internal]
echo   --file ^<path^>           Specific App Bundle file to upload
echo   -h, --help             Show this help message
echo.
echo Examples:
echo   %~nx0 prod --build-first --track production
echo   %~nx0 stg --track beta
echo   %~nx0 dev --file build\app\outputs\bundle\dev\app-dev.aab
echo.
echo Note: This script requires proper Google Play Console API setup.
echo See documentation for setting up service account and API access.
goto :end

:args_done

REM Validate required parameters
if "%FLAVOR%"=="" (
    call :log_error "Flavor is required"
    goto :show_help
)

REM Validate environment
call :validate_environment
if %errorlevel% neq 0 goto :end

call :validate_flavor "%FLAVOR%"
if %errorlevel% neq 0 goto :end

REM Validate track
call :validate_track "%TRACK%"
if %errorlevel% neq 0 goto :end

REM Show configuration summary
call :show_config_summary "%FLAVOR%" "android"

REM Get configuration from centralized configs
call :get_app_display_name "%FLAVOR%" APP_NAME
call :get_android_package_name "%FLAVOR%" PACKAGE_NAME
call :get_pubspec_version VERSION

call :log_step "🚀 Preparing Google Play Store upload..."
echo App: %APP_NAME%
echo Package: %PACKAGE_NAME%
echo Version: %VERSION%
echo Flavor: %FLAVOR%
echo Track: %TRACK%
echo.

REM Build first if requested
if "%BUILD_FIRST%"=="true" (
    call :log_step "Building App Bundle before upload..."
    call "%SCRIPT_DIR%..\build\build_appbundle.bat" "%FLAVOR%"
    if %errorlevel% neq 0 (
        call :log_error "App Bundle build failed"
        goto :end
    )
    call :log_success "App Bundle built successfully"
    echo.
)

REM Determine App Bundle file path
if "%SPECIFIC_FILE%" neq "" (
    set "AAB_FILE=%SPECIFIC_FILE%"
) else (
    call :get_output_path "android" "appbundle" BUNDLE_OUTPUT_PATH
    set "AAB_FILE=%ROOT_DIR%\%BUNDLE_OUTPUT_PATH%\%FLAVOR%Release\app-%FLAVOR%-release.aab"
)

REM Validate App Bundle file exists
if not exist "%AAB_FILE%" (
    call :log_error "App Bundle file not found: %AAB_FILE%"
    call :log_info "Please build the App Bundle first or specify a valid file path"
    call :log_info "Build command: tools\windows\build\build_appbundle.bat %FLAVOR%"
    goto :end
)

call :log_info "Using App Bundle: %AAB_FILE%"

REM Check for Fastlane (preferred method)
where fastlane >nul 2>&1
if %errorlevel% equ 0 (
    call :upload_with_fastlane
) else (
    call :log_warning "Fastlane not found. Attempting manual upload instructions..."
    call :show_manual_upload_instructions
)

call :log_success "🎉 Upload process completed!"
echo.
echo Please check Google Play Console for upload status and review process.

goto :end

REM ============================================
REM Helper Functions
REM ============================================

:validate_track
set "track=%~1"
if "%track%"=="internal" exit /b 0
if "%track%"=="alpha" exit /b 0
if "%track%"=="beta" exit /b 0
if "%track%"=="production" exit /b 0

call :log_error "Invalid track: %track%"
call :log_info "Supported tracks: internal, alpha, beta, production"
exit /b 1

:upload_with_fastlane
call :log_step "Uploading to Google Play Store using Fastlane..."

REM Check if Fastfile exists
if not exist "%ROOT_DIR%\android\fastlane\Fastfile" (
    call :log_warning "Fastfile not found. Please set up Fastlane for this project."
    call :show_fastlane_setup_instructions
    exit /b 1
)

REM Navigate to android directory and run Fastlane
cd /d "%ROOT_DIR%\android"

REM Run Fastlane upload
fastlane upload_to_play_store aab:"%AAB_FILE%" track:%TRACK% skip_upload_apk:true skip_upload_metadata:true skip_upload_images:true skip_upload_screenshots:true

if %errorlevel% equ 0 (
    call :log_success "App Bundle uploaded successfully via Fastlane!"
) else (
    call :log_error "Fastlane upload failed. Check the output above for details."
    call :show_manual_upload_instructions
)

cd /d "%ROOT_DIR%"
exit /b 0

:show_fastlane_setup_instructions
echo.
call :log_info "To set up Fastlane for Google Play Console uploads:"
echo.
echo 1. Install Fastlane: gem install fastlane
echo 2. Navigate to android directory: cd android
echo 3. Initialize Fastlane: fastlane init
echo 4. Set up Google Play Console API access (service account JSON)
echo 5. Configure Fastfile with upload lane
echo.
echo See: https://docs.fastlane.tools/getting-started/android/setup/
exit /b 0

:show_manual_upload_instructions
echo.
call :log_info "Manual upload instructions:"
echo.
echo 1. Open Google Play Console: https://play.google.com/console
echo 2. Select your app: %PACKAGE_NAME%
echo 3. Navigate to: Release ^> %TRACK%
echo 4. Create new release
echo 5. Upload App Bundle: %AAB_FILE%
echo 6. Fill in release notes and publish
echo.
echo For API-based uploads, consider setting up:
echo - Google Play Console API
echo - Service account with proper permissions
echo - Fastlane or gradle-play-publisher plugin
exit /b 0

:end
endlocal

REM Pause for user removed for automation
</file>

<file path="tools/windows/git/feature.bat">
@echo off
setlocal enabledelayedexpansion

REM Enhanced Feature Branch Management Script for Windows
REM This script helps manage feature branches following GitFlow patterns

REM Navigate to the root directory
set "SCRIPT_DIR=%~dp0"
set "ROOT_DIR=%SCRIPT_DIR%..\..\..\"
cd /d "%ROOT_DIR%"
if %errorlevel% neq 0 (
    echo ❌ Failed to navigate to the project root directory.
    exit /b 1
)

REM Load common utilities
call "%SCRIPT_DIR%utils.bat" 2>nul

REM Parse command and arguments
set "COMMAND=%~1"
set "TICKET_ID=%~2"
set "DESCRIPTION=%~3"

if "%COMMAND%"=="" goto :show_usage
if "%COMMAND%"=="help" goto :show_usage

goto :handle_command

:show_usage
echo Usage: %~nx0 ^<command^> [options]
echo.
echo Commands:
echo   start ^<ticket-id^> ^<description^>  Start a new feature branch
echo   finish                            Finish current feature branch
echo   publish                           Push feature branch to remote
echo   list                              List all feature branches
echo   help                              Show this help message
echo.
echo Examples:
echo   %~nx0 start TG-123 login-social
echo   %~nx0 finish
echo   %~nx0 publish
echo.
echo Note: Follows GitFlow conventions with feature/ prefix
goto :end

:handle_command
if "%COMMAND%"=="start" goto :start_feature
if "%COMMAND%"=="finish" goto :finish_feature
if "%COMMAND%"=="publish" goto :publish_feature
if "%COMMAND%"=="list" goto :list_features

echo ❌ Unknown command: %COMMAND%
goto :show_usage

:start_feature
if "%TICKET_ID%"=="" (
    echo ❌ Error: Missing ticket ID or description
    echo Usage: %~nx0 start ^<ticket-id^> ^<description^>
    exit /b 1
)
if "%DESCRIPTION%"=="" (
    echo ❌ Error: Missing description
    echo Usage: %~nx0 start ^<ticket-id^> ^<description^>
    exit /b 1
)

set "BRANCH_NAME=feature/%TICKET_ID%-%DESCRIPTION%"

echo 🚀 Starting new feature: %BRANCH_NAME%

REM Ensure we're on develop and up to date
echo 🔄 Switching to develop branch...
git checkout develop
if %errorlevel% neq 0 (
    echo ❌ Failed to checkout develop branch
    exit /b 1
)

echo 📥 Pulling latest changes from develop...
git pull origin develop
if %errorlevel% neq 0 (
    echo ⚠️ Failed to pull from develop. Continuing with local develop.
)

REM Create and checkout new feature branch
echo 🌿 Creating feature branch: %BRANCH_NAME%
git checkout -b "%BRANCH_NAME%"
if %errorlevel% neq 0 (
    echo ❌ Failed to create feature branch
    exit /b 1
)

echo ✅ Feature branch created: %BRANCH_NAME%
echo 💡 You can now start working on your feature
echo.
echo Next steps:
echo   1. Make your changes
echo   2. Commit your work: git add . && git commit -m "your message"
echo   3. When ready: %~nx0 finish
goto :end

:finish_feature
REM Get current branch
for /f "tokens=*" %%i in ('git branch --show-current') do set "CURRENT_BRANCH=%%i"

echo %CURRENT_BRANCH% | findstr /r "^feature/" >nul
if %errorlevel% neq 0 (
    echo ❌ Error: Not on a feature branch
    echo Current branch: %CURRENT_BRANCH%
    exit /b 1
)

echo 🏁 Finishing feature: %CURRENT_BRANCH%

REM Check if there are uncommitted changes
call :check_clean_working_tree
if %errorlevel% neq 0 exit /b 1

REM Extract ticket ID from branch name
call :extract_ticket_id "%CURRENT_BRANCH%" TICKET_ID

REM Make sure develop is up to date
echo 📡 Fetching latest develop...
git fetch origin develop
if %errorlevel% neq 0 (
    echo ⚠️ Failed to fetch develop. Continuing with local develop.
)

REM Push current branch to remote if it's not already there
call :branch_exists_remote "%CURRENT_BRANCH%" REMOTE_EXISTS
if "%REMOTE_EXISTS%"=="false" (
    echo 📤 Pushing feature branch to remote...
    git push -u origin "%CURRENT_BRANCH%"
    if %errorlevel% neq 0 (
        echo ❌ Failed to push branch to remote
        exit /b 1
    )
) else (
    echo 📝 Feature branch already exists on remote

    REM Make sure local branch is up to date with remote
    echo 🔄 Updating local branch from remote...
    git pull origin "%CURRENT_BRANCH%"
    if %errorlevel% neq 0 (
        echo ⚠️ Failed to pull from remote. Continuing with local changes.
    )
)

REM Create PR title based on branch name
for /f "tokens=2 delims=-" %%i in ("%CURRENT_BRANCH%") do set "BRANCH_DESCRIPTION=%%i"
if "%BRANCH_DESCRIPTION%"=="" set "BRANCH_DESCRIPTION=%CURRENT_BRANCH:feature/=%"

REM Convert description for PR title
set "PR_TITLE=feature-%TICKET_ID%: %BRANCH_DESCRIPTION%"
set "PR_TITLE=!PR_TITLE:-= !"

REM Create pull request (if GitHub CLI is available)
echo 🔗 Creating pull request...
where gh >nul 2>&1
if %errorlevel% equ 0 (
    gh pr create --title "%PR_TITLE%" --body "Feature implementation for %TICKET_ID%" --base develop --head "%CURRENT_BRANCH%"
    if %errorlevel% equ 0 (
        echo ✅ Pull request created successfully!
    ) else (
        echo ⚠️ Failed to create pull request via GitHub CLI
        call :show_manual_pr_instructions
    )
) else (
    echo ⚠️ GitHub CLI not found
    call :show_manual_pr_instructions
)

echo ✅ Feature completed and ready for review!
echo 💡 After the pull request is approved and merged, you can delete your local branch with:
echo    git branch -d %CURRENT_BRANCH%
goto :end

:publish_feature
for /f "tokens=*" %%i in ('git branch --show-current') do set "CURRENT_BRANCH=%%i"

echo %CURRENT_BRANCH% | findstr /r "^feature/" >nul
if %errorlevel% neq 0 (
    echo ❌ Error: Not on a feature branch
    echo Current branch: %CURRENT_BRANCH%
    exit /b 1
)

echo 📤 Publishing feature: %CURRENT_BRANCH%

git push -u origin "%CURRENT_BRANCH%"
if %errorlevel% equ 0 (
    echo ✅ Feature branch published to remote
) else (
    echo ❌ Failed to publish feature branch
    exit /b 1
)
goto :end

:list_features
echo 📋 Local feature branches:
git branch | findstr "feature/"
echo.
echo 📡 Remote feature branches:
git branch -r | findstr "origin/feature/"
goto :end

REM ============================================
REM Helper Functions
REM ============================================

:check_clean_working_tree
git diff-index --quiet HEAD --
if %errorlevel% neq 0 (
    echo ❌ Error: You have uncommitted changes
    echo Please commit or stash your changes before finishing the feature
    git status --porcelain
    exit /b 1
)
exit /b 0

:extract_ticket_id
set "branch_name=%~1"
set "result_var=%~2"

REM Extract ticket ID pattern like TG-123, PROJ-456, etc.
for /f "tokens=2 delims=/" %%i in ("%branch_name%") do (
    for /f "tokens=1 delims=-" %%j in ("%%i") do (
        for /f "tokens=2 delims=-" %%k in ("%%i") do (
            set "%result_var%=%%j-%%k"
            exit /b 0
        )
    )
)
set "%result_var%="
exit /b 0

:branch_exists_remote
set "branch_name=%~1"
set "result_var=%~2"

git ls-remote --heads origin "%branch_name%" | findstr "%branch_name%" >nul
if %errorlevel% equ 0 (
    set "%result_var%=true"
) else (
    set "%result_var%=false"
)
exit /b 0

:show_manual_pr_instructions
echo.
echo 📝 Manual Pull Request Instructions:
echo 1. Open your repository in a web browser
echo 2. Navigate to Pull Requests section
echo 3. Click "New Pull Request"
echo 4. Select base: develop, compare: %CURRENT_BRANCH%
echo 5. Title: %PR_TITLE%
echo 6. Add description and submit for review
echo.
echo Alternatively, install GitHub CLI for automated PR creation:
echo https://cli.github.com/
exit /b 0

:end
endlocal
</file>

<file path="tools/windows/git/README.md">
# GitFlow Workflow for Flutter Projects

## Overview
This GitFlow implementation provides a structured branching strategy and automated workflow for Flutter projects. It includes automated commit message validation, branch naming conventions, and helper scripts.

## Branch Structure

### Main Branches
- **main/master**: Production-ready code
- **develop**: Development integration branch

### Supporting Branches
- **feature/**: New features (from develop)
- **release/**: Prepare for production release (from develop)
- **hotfix/**: Emergency fixes (from main)
- **bugfix/**: Bug fixes in development (from develop)

## Branch Naming Convention

### Format
`<type>/<ticket-id>/<short-description>`

### Examples
- `feature/ARTLEXIS-123/add-user-authentication`
- `release/1.2.0/prepare-release`
- `hotfix/ARTLEXIS-456/fix-login-crash`
- `bugfix/ARTLEXIS-789/fix-ui-alignment`

## Commit Message Convention

### Format
```
<type>(<scope>): <subject>

[optional body]

[optional footer(s)]
```

### Types
- **feat**: New feature
- **fix**: Bug fix
- **docs**: Documentation changes
- **style**: Code style changes (formatting, missing semicolons, etc.)
- **refactor**: Code refactoring
- **perf**: Performance improvements
- **test**: Adding or updating tests
- **build**: Build system or external dependencies
- **ci**: CI/CD configuration
- **chore**: Other changes that don't modify src or test files

### Examples
```
feat(auth): add biometric authentication support

- Implement fingerprint authentication for iOS and Android
- Add fallback to PIN authentication
- Update security settings UI

ARTLEXIS-123
```

```
fix(gallery): resolve image loading crash on low memory devices

ARTLEXIS-456
```

## Quick Start

### 1. Setup GitFlow
```bash
./tools/macos/git/setup.sh
```

### 2. Start a Feature
```bash
./tools/macos/git/feature.sh start ARTLEXIS-123 "add user authentication"
```

### 3. Finish a Feature
```bash
./tools/macos/git/feature.sh finish
```

### 4. Create a Release
```bash
./tools/macos/git/release.sh start 1.2.0
```

### 5. Create a Hotfix
```bash
./tools/macos/git/hotfix.sh start ARTLEXIS-456 "fix login crash"
```

## Workflow Process

### Feature Development
1. Create feature branch from develop
2. Make commits following convention
3. Push changes regularly
4. Create pull request to develop
5. After review, merge to develop

### Release Process
1. Create release branch from develop
2. Update version numbers
3. Fix release-specific bugs
4. Merge to main and develop
5. Tag the release

### Hotfix Process
1. Create hotfix branch from main
2. Fix the critical issue
3. Update version (patch)
4. Merge to main and develop
5. Tag the hotfix

## Git Hooks
The following hooks are automatically installed:
- **commit-msg**: Validates commit message format
- **pre-commit**: Runs Flutter analyze and format check
- **pre-push**: Validates branch naming convention

## Configuration
Edit `.gitflow.config` to customize:
- Branch prefixes
- Commit types
- Ticket prefix patterns
- Version format

## Troubleshooting

### Hook Permission Issues
```bash
chmod +x .git/hooks/*
```

### Bypass Hooks (Emergency Only)
```bash
git commit --no-verify
```

### Reset GitFlow
```bash
./tools/macos/git/setup.sh --reset
```
</file>

<file path="tools/windows/git/release.bat">
@echo off
setlocal enabledelayedexpansion

REM Enhanced Release Management Script for Windows
REM This script helps manage release branches following GitFlow patterns

REM Navigate to the root directory
set "SCRIPT_DIR=%~dp0"
set "ROOT_DIR=%SCRIPT_DIR%..\..\..\"
cd /d "%ROOT_DIR%"
if %errorlevel% neq 0 (
    echo ❌ Failed to navigate to the project root directory.
    exit /b 1
)

REM Load utilities
call "%SCRIPT_DIR%utils.bat"

REM Parse command and arguments
set "COMMAND=%~1"
set "VERSION=%~2"

if "%COMMAND%"=="" goto :show_usage
if "%COMMAND%"=="help" goto :show_usage

REM Validate git environment
call :check_git_installed
if %errorlevel% neq 0 exit /b 1

call :check_git_repo
if %errorlevel% neq 0 exit /b 1

goto :handle_command

:show_usage
echo Usage: %~nx0 ^<command^> [version]
echo.
echo Commands:
echo   start [version]     Start a new release branch
echo   finish              Finish current release branch
echo   publish             Push release branch to remote
echo   list                List all release branches
echo   help                Show this help message
echo.
echo Examples:
echo   %~nx0 start 1.2.0
echo   %~nx0 start         # Auto-detect version from pubspec.yaml
echo   %~nx0 finish
echo   %~nx0 publish
echo.
echo Note: Follows GitFlow conventions with release/ prefix
goto :end

:handle_command
if "%COMMAND%"=="start" goto :start_release
if "%COMMAND%"=="finish" goto :finish_release
if "%COMMAND%"=="publish" goto :publish_release
if "%COMMAND%"=="list" goto :list_releases

echo ❌ Unknown command: %COMMAND%
goto :show_usage

:start_release
REM Get version from argument or pubspec.yaml
if "%VERSION%"=="" (
    call :get_version_from_pubspec VERSION
    if "%VERSION%"=="" (
        echo ❌ Could not determine version. Please specify version or check pubspec.yaml
        echo Usage: %~nx0 start ^<version^>
        exit /b 1
    )
    echo 📋 Auto-detected version from pubspec.yaml: %VERSION%
)

set "BRANCH_NAME=release/%VERSION%"

echo 🚀 Starting new release: %BRANCH_NAME%

REM Check if release branch already exists
call :branch_exists_local "%BRANCH_NAME%"
if %errorlevel% equ 0 (
    echo ❌ Release branch already exists: %BRANCH_NAME%
    echo Use 'git checkout %BRANCH_NAME%' to switch to it
    exit /b 1
)

REM Ensure we're on develop and up to date
echo 🔄 Switching to develop branch...
git checkout develop
if %errorlevel% neq 0 (
    echo ❌ Failed to checkout develop branch
    exit /b 1
)

echo 📥 Pulling latest changes from develop...
git pull origin develop
if %errorlevel% neq 0 (
    echo ⚠️ Failed to pull from develop. Continuing with local develop.
)

REM Ensure working tree is clean
call :check_clean_working_tree
if %errorlevel% neq 0 exit /b 1

REM Create release branch
echo 🌿 Creating release branch: %BRANCH_NAME%
git checkout -b "%BRANCH_NAME%"
if %errorlevel% neq 0 (
    echo ❌ Failed to create release branch
    exit /b 1
)

echo ✅ Release branch created: %BRANCH_NAME%
echo.
echo 📝 Next steps:
echo   1. Update version numbers if needed
echo   2. Update CHANGELOG.md
echo   3. Test the release
echo   4. Commit any final changes
echo   5. Run: %~nx0 finish
goto :end

:finish_release
REM Get current branch
call :get_current_branch CURRENT_BRANCH

echo %CURRENT_BRANCH% | findstr /r "^release/" >nul
if %errorlevel% neq 0 (
    echo ❌ Error: Not on a release branch
    echo Current branch: %CURRENT_BRANCH%
    exit /b 1
)

REM Extract version from branch name
for /f "tokens=2 delims=/" %%i in ("%CURRENT_BRANCH%") do set "RELEASE_VERSION=%%i"

echo 🏁 Finishing release: %CURRENT_BRANCH% (v%RELEASE_VERSION%)

REM Ensure working tree is clean
call :check_clean_working_tree
if %errorlevel% neq 0 exit /b 1

REM Push release branch to remote if not already there
call :branch_exists_remote "%CURRENT_BRANCH%"
if %errorlevel% neq 0 (
    echo 📤 Pushing release branch to remote...
    git push -u origin "%CURRENT_BRANCH%"
    if %errorlevel% neq 0 (
        echo ❌ Failed to push release branch to remote
        exit /b 1
    )
)

REM Merge to main/master
echo 🔄 Fetching latest main branch...
git fetch origin main 2>nul || git fetch origin master
if %errorlevel% neq 0 (
    echo ⚠️ Could not fetch main/master branch
)

echo 🔀 Merging release to main...
git checkout main 2>nul || git checkout master
if %errorlevel% neq 0 (
    echo ❌ Failed to checkout main/master branch
    exit /b 1
)

git merge --no-ff "%CURRENT_BRANCH%" -m "release-v%RELEASE_VERSION%: Merge release branch"
if %errorlevel% neq 0 (
    echo ❌ Failed to merge release to main
    echo Please resolve conflicts manually
    exit /b 1
)

REM Create release tag
echo 🏷️ Creating release tag: v%RELEASE_VERSION%
git tag -a "v%RELEASE_VERSION%" -m "Release version %RELEASE_VERSION%"
if %errorlevel% neq 0 (
    echo ⚠️ Failed to create tag
)

REM Merge back to develop
echo 🔀 Merging changes back to develop...
git checkout develop
if %errorlevel% neq 0 (
    echo ❌ Failed to checkout develop branch
    exit /b 1
)

git merge --no-ff "%CURRENT_BRANCH%" -m "release-v%RELEASE_VERSION%: Merge release changes to develop"
if %errorlevel% neq 0 (
    echo ⚠️ Failed to merge release to develop. Please resolve manually.
)

REM Push everything
echo 📤 Pushing all changes...
git checkout main 2>nul || git checkout master
git push origin main 2>nul || git push origin master
git push origin "v%RELEASE_VERSION%"

git checkout develop
git push origin develop

REM Clean up local release branch
echo 🧹 Cleaning up release branch...
git branch -d "%CURRENT_BRANCH%"

echo ✅ Release v%RELEASE_VERSION% completed successfully!
echo.
echo 📝 Summary:
echo   - Release merged to main
echo   - Changes merged back to develop
echo   - Tag v%RELEASE_VERSION% created
echo   - Release branch deleted locally
echo.
echo 🚀 Next steps:
echo   1. Create GitHub release from tag v%RELEASE_VERSION%
echo   2. Update release notes
echo   3. Deploy to production
goto :end

:publish_release
call :get_current_branch CURRENT_BRANCH

echo %CURRENT_BRANCH% | findstr /r "^release/" >nul
if %errorlevel% neq 0 (
    echo ❌ Error: Not on a release branch
    echo Current branch: %CURRENT_BRANCH%
    exit /b 1
)

echo 📤 Publishing release: %CURRENT_BRANCH%

git push -u origin "%CURRENT_BRANCH%"
if %errorlevel% equ 0 (
    echo ✅ Release branch published to remote
) else (
    echo ❌ Failed to publish release branch
    exit /b 1
)
goto :end

:list_releases
echo 📋 Local release branches:
git branch | findstr "release/"
echo.
echo 📡 Remote release branches:
git branch -r | findstr "origin/release/"
echo.
echo 🏷️ Recent release tags:
git tag | findstr "^v[0-9]" | powershell "Get-Content | Sort-Object {[version]($_ -replace '^v','')} | Select-Object -Last 10"
goto :end

:end
endlocal
</file>

<file path="tools/windows/git/setup.bat">
@echo off
setlocal enabledelayedexpansion

REM Git Setup Script for Windows
REM Sets up GitFlow workflow for the project

REM Navigate to the root directory relative to the current script location
set "SCRIPT_DIR=%~dp0"
set "ROOT_DIR=%SCRIPT_DIR%..\..\..\"
cd /d "%ROOT_DIR%" || (
    echo ❌ Failed to navigate to the project root directory.
    exit /b 1
)

echo 🚀 Setting up GitFlow workflow for the project (Windows)...
echo 📍 Project root: %CD%

REM Check if we're in a git repository
if not exist ".git" (
    echo ❌ Not a git repository. Please run 'git init' first.
    exit /b 1
)

REM Create hooks directory if it doesn't exist
if not exist ".git\hooks" mkdir ".git\hooks"

REM Create a simple commit-msg hook
echo 📝 Installing commit message validation hook...
(
echo @echo off
echo REM Simple commit message validation
echo.
echo set "commit_file=%%1"
echo for /f "delims=" %%%%i in ^(%%commit_file%%^) do ^(
echo     set "commit_msg=%%%%i"
echo     goto :validate
echo ^)
echo.
echo :validate
echo echo %%commit_msg%% ^| findstr /r "^feat.*:" ^>nul ^|^| ^(
echo echo %%commit_msg%% ^| findstr /r "^fix.*:" ^>nul ^|^| ^(
echo echo %%commit_msg%% ^| findstr /r "^docs.*:" ^>nul ^|^| ^(
echo echo %%commit_msg%% ^| findstr /r "^style.*:" ^>nul ^|^| ^(
echo echo %%commit_msg%% ^| findstr /r "^refactor.*:" ^>nul ^|^| ^(
echo echo %%commit_msg%% ^| findstr /r "^test.*:" ^>nul ^|^| ^(
echo echo %%commit_msg%% ^| findstr /r "^chore.*:" ^>nul ^|^| ^(
echo     echo Invalid commit message format!
echo     echo Format should be: type^(scope^): description
echo     echo Types: feat, fix, docs, style, refactor, test, chore
echo     echo Example: feat^(auth^): add login functionality
echo     exit /b 1
echo ^)^)^)^)^)^)^)
) > ".git\hooks\commit-msg.bat"

REM Initialize git flow branches if they don't exist
echo 🌿 Checking branch structure...
git show-ref --verify --quiet refs/heads/main
if %errorlevel% neq 0 (
    echo Creating main branch...
    git checkout -b main 2>nul || echo Main branch already exists or checkout failed
)

git show-ref --verify --quiet refs/heads/develop
if %errorlevel% neq 0 (
    echo Creating develop branch...
    git checkout -b develop 2>nul || echo Develop branch already exists or checkout failed
)

REM Create local config for git flow
echo ⚙️  Configuring GitFlow settings...
git config gitflow.branch.master main
git config gitflow.branch.develop develop
git config gitflow.prefix.feature feature/
git config gitflow.prefix.release release/
git config gitflow.prefix.hotfix hotfix/
git config gitflow.prefix.support support/
git config gitflow.prefix.versiontag v

echo ✅ GitFlow setup completed successfully!
echo.
echo 📚 Available commands:
echo   - tools\windows\git\utils.bat    : Git utility functions
echo.
echo 💡 Note: This is a simplified setup for Windows
echo     For full GitFlow functionality, install Git Flow for Windows:
echo     https://github.com/nvie/gitflow/wiki/Windows
echo.
echo 🚀 You can now start development with:
echo     git checkout develop
echo     git checkout -b feature/your-feature-name

REM Pause for user removed for automation
exit /b 0
</file>

<file path="tools/windows/git/utils.bat">
@echo off
setlocal enabledelayedexpansion

REM Git Utility Functions for Windows
REM Common functions used by other git scripts

REM Function to check if git is installed
:check_git_installed
where git >nul 2>&1
if %errorlevel% neq 0 (
    echo ❌ Git is not installed or not in PATH
    echo Please install Git and try again
    exit /b 1
)
exit /b 0

REM Function to check if we're in a git repository
:check_git_repo
git rev-parse --git-dir >nul 2>&1
if %errorlevel% neq 0 (
    echo ❌ Not in a git repository
    echo Please run this script from within a git repository
    exit /b 1
)
exit /b 0

REM Function to check if working tree is clean
:check_clean_working_tree
git diff-index --quiet HEAD --
if %errorlevel% neq 0 (
    echo ❌ Working tree is not clean
    echo Please commit or stash your changes first
    git status --porcelain
    exit /b 1
)
exit /b 0

REM Function to get current branch name
:get_current_branch
for /f "tokens=*" %%i in ('git branch --show-current 2^>nul') do (
    set "%~1=%%i"
    exit /b 0
)
set "%~1="
exit /b 1

REM Function to check if branch exists locally
:branch_exists_local
set "branch_name=%~1"
git show-ref --verify --quiet refs/heads/%branch_name%
exit /b %errorlevel%

REM Function to check if branch exists on remote
:branch_exists_remote
set "branch_name=%~1"
git ls-remote --heads origin "%branch_name%" | findstr "%branch_name%" >nul
exit /b %errorlevel%

REM Function to switch to branch (create if doesn't exist)
:switch_to_branch
set "branch_name=%~1"
set "base_branch=%~2"

call :branch_exists_local "%branch_name%"
if %errorlevel% equ 0 (
    echo 🔄 Switching to existing branch: %branch_name%
    git checkout "%branch_name%"
) else (
    if "%base_branch%" neq "" (
        echo 🌿 Creating new branch: %branch_name% from %base_branch%
        git checkout -b "%branch_name%" "%base_branch%"
    ) else (
        echo 🌿 Creating new branch: %branch_name%
        git checkout -b "%branch_name%"
    )
)
exit /b %errorlevel%

REM Function to push branch to remote
:push_to_remote
set "branch_name=%~1"
if "%branch_name%"=="" (
    call :get_current_branch branch_name
)

echo 📤 Pushing %branch_name% to remote...
git push -u origin "%branch_name%"
exit /b %errorlevel%

REM Function to pull latest changes from remote
:pull_from_remote
set "branch_name=%~1"
if "%branch_name%"=="" (
    call :get_current_branch branch_name
)

echo 📥 Pulling latest changes for %branch_name%...
git pull origin "%branch_name%"
exit /b %errorlevel%

REM Function to extract ticket ID from branch name
:extract_ticket_id
set "branch_name=%~1"
set "result_var=%~2"

REM Extract pattern like TG-123, PROJ-456, etc. from feature/TG-123-description
for /f "tokens=2 delims=/" %%i in ("%branch_name%") do (
    for /f "tokens=1,2 delims=-" %%j in ("%%i") do (
        set "%result_var%=%%j-%%k"
        exit /b 0
    )
)
set "%result_var%="
exit /b 1

REM Function to create pull request using GitHub CLI
:create_pull_request
set "source_branch=%~1"
set "target_branch=%~2"
set "pr_title=%~3"
set "pr_body=%~4"

where gh >nul 2>&1
if %errorlevel% neq 0 (
    echo ⚠️ GitHub CLI not found. Cannot create pull request automatically.
    echo Please create the pull request manually at your repository.
    exit /b 1
)

if "%pr_body%"=="" set "pr_body=Automated pull request from %source_branch%"

echo 🔗 Creating pull request: %pr_title%
gh pr create --title "%pr_title%" --body "%pr_body%" --base "%target_branch%" --head "%source_branch%"
exit /b %errorlevel%

REM Function to get version from pubspec.yaml
:get_version_from_pubspec
set "result_var=%~1"
set "pubspec_file=pubspec.yaml"

if not exist "%pubspec_file%" (
    set "%result_var%="
    exit /b 1
)

for /f "tokens=2" %%i in ('findstr "^version:" "%pubspec_file%"') do (
    set "version=%%i"
    REM Remove any comments
    for /f "tokens=1 delims=#" %%j in ("!version!") do (
        set "version=%%j"
        set "version=!version: =!"
        set "%result_var%=!version!"
        exit /b 0
    )
)
set "%result_var%="
exit /b 1

REM Function to validate branch name format
:validate_branch_name
set "branch_name=%~1"
set "pattern=%~2"

echo %branch_name% | findstr /r "%pattern%" >nul
exit /b %errorlevel%

REM Function to get last commit message
:get_last_commit_message
set "result_var=%~1"
for /f "tokens=*" %%i in ('git log -1 --pretty=format:"%%s" 2^>nul') do (
    set "%result_var%=%%i"
    exit /b 0
)
set "%result_var%="
exit /b 1

REM Function to check if current branch is ahead of remote
:is_ahead_of_remote
set "branch_name=%~1"
if "%branch_name%"=="" (
    call :get_current_branch branch_name
)

for /f %%i in ('git rev-list --count origin/%branch_name%..HEAD 2^>nul') do (
    if %%i gtr 0 (
        exit /b 0
    ) else (
        exit /b 1
    )
)
exit /b 1

REM Function to check if current branch is behind remote
:is_behind_remote
set "branch_name=%~1"
if "%branch_name%"=="" (
    call :get_current_branch branch_name
)

for /f %%i in ('git rev-list --count HEAD..origin/%branch_name% 2^>nul') do (
    if %%i gtr 0 (
        exit /b 0
    ) else (
        exit /b 1
    )
)
exit /b 1

REM Function to display git status summary
:show_git_status
echo 📊 Git Status Summary:
echo ━━━━━━━━━━━━━━━━━━━━━━━━━━

call :get_current_branch current_branch
echo Branch: %current_branch%

call :is_ahead_of_remote "%current_branch%"
if %errorlevel% equ 0 (
    echo Status: ⬆️ Ahead of remote
) else (
    call :is_behind_remote "%current_branch%"
    if %errorlevel% equ 0 (
        echo Status: ⬇️ Behind remote
    ) else (
        echo Status: ✅ Up to date
    )
)

git status --porcelain | find /c /v "" >nul
if %errorlevel% equ 0 (
    echo Changes: ✅ Clean working tree
) else (
    echo Changes: ⚠️ Uncommitted changes
)

echo ━━━━━━━━━━━━━━━━━━━━━━━━━━
exit /b 0

REM Entry point - show available functions if called directly
:main
if "%~0"=="%~nx0" (
    echo Git Utility Functions for Windows
    echo ================================
    echo.
    echo Available functions:
    echo   :check_git_installed
    echo   :check_git_repo
    echo   :check_clean_working_tree
    echo   :get_current_branch
    echo   :branch_exists_local
    echo   :branch_exists_remote
    echo   :switch_to_branch
    echo   :push_to_remote
    echo   :pull_from_remote
    echo   :extract_ticket_id
    echo   :create_pull_request
    echo   :get_version_from_pubspec
    echo   :validate_branch_name
    echo   :show_git_status
    echo.
    echo Usage: call "%~nx0" from other batch files
    REM Pause for user removed for automation
)
exit /b 0

REM Run main if script is executed directly
if "%~0"=="%~nx0" call :main
</file>

<file path="tools/windows/key/generate_keystore.bat">
@echo off
setlocal enabledelayedexpansion

REM Enhanced Keystore Generation Script with Centralized Configuration (Windows)
REM This script generates Android keystore files using configuration from .info\ directory

REM Navigate to the root directory relative to the current script location
set "ROOT_DIR=%~dp0..\..\.."
cd /d "%ROOT_DIR%"
if %errorlevel% neq 0 (
