#!/bin/bash

# Commit message validation hook for GitFlow
# This hook validates commit messages against the project's commit convention

# Get the commit message
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Define valid commit types
VALID_TYPES="feature|fix|hotfix|release|docs|style|refactor|test|chore"

# Commit message pattern
# Format: type(scope): subject
# Examples:
#   feature(auth): Add social login
#   fix(payment): Fix credit card validation
#   feature-TG-123-login: Add OAuth integration
PATTERN="^($VALID_TYPES)(\([a-zA-Z0-9-]+\))?(-[A-Z]+-[0-9]+)?(-[a-z0-9-]+)?: .+"

# Check if commit message matches the pattern
if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo -e "${RED}❌ Invalid commit message format!${NC}"
    echo ""
    echo -e "${YELLOW}Commit message:${NC} $COMMIT_MSG"
    echo ""
    echo -e "${GREEN}Valid format:${NC} type(scope): subject"
    echo -e "${GREEN}Or with ticket:${NC} type-TICKET-ID-description: subject"
    echo ""
    echo -e "${GREEN}Valid types:${NC} $VALID_TYPES"
    echo ""
    echo -e "${GREEN}Examples:${NC}"
    echo "  feature(auth): Add social login functionality"
    echo "  fix(validation): Fix email regex pattern"
    echo "  feature-ARTLEXIS-123-login: Implement OAuth2 authentication"
    echo "  fix-TG-456: Resolve payment gateway timeout"
    echo ""
    echo -e "${YELLOW}💡 Tip:${NC} Use branch ticket ID in your commit for traceability"
    exit 1
fi

# Check commit message length
SUBJECT_LENGTH=${#COMMIT_MSG}
if [ $SUBJECT_LENGTH -gt 100 ]; then
    echo -e "${YELLOW}⚠️  Warning: Commit message is too long (${SUBJECT_LENGTH} chars)${NC}"
    echo "Consider keeping it under 100 characters for better readability."
    echo ""
fi

# Extract type and validate specific rules
TYPE=$(echo "$COMMIT_MSG" | sed -E 's/^([a-z]+).*/\1/')

# Ensure feature commits reference a ticket when on feature branches
CURRENT_BRANCH=$(git branch --show-current)
if [[ "$CURRENT_BRANCH" =~ ^(feature|fix|hotfix)/ ]]; then
    # Extract ticket ID from branch name
    BRANCH_TICKET=$(echo "$CURRENT_BRANCH" | sed -E 's/^[^\/]+\/([A-Z]+-[0-9]+)-.*/\1/')
    
    # Check if commit message contains the ticket ID
    if [[ -n "$BRANCH_TICKET" ]] && [[ ! "$COMMIT_MSG" =~ $BRANCH_TICKET ]]; then
        echo -e "${YELLOW}💡 Tip: Your branch references ticket $BRANCH_TICKET${NC}"
        echo "Consider including it in your commit message for better traceability."
        echo ""
    fi
fi

echo -e "${GREEN}✅ Commit message validated successfully!${NC}"
exit 0 