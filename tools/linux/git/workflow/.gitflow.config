# GitFlow Configuration File
# This file defines the GitFlow workflow settings for the project

# Main branches
MAIN_BRANCH=main
DEVELOP_BRANCH=develop

# Feature branches
FEATURE_PREFIX=feature/
# Format: feature/TICKET-ID-description
# Example: feature/ARTLEXIS-123-login-social

# Fix branches (for non-critical bugs during development)
FIX_PREFIX=fix/
# Format: fix/TICKET-ID-description
# Example: fix/ARTLEXIS-456-validation-error

# Release branches
RELEASE_PREFIX=release/
# Format: release/VERSION
# Example: release/1.2.0

# Hotfix branches (for critical production bugs)
HOTFIX_PREFIX=hotfix/
# Format: hotfix/TICKET-ID-description
# Example: hotfix/ARTLEXIS-789-payment-crash

# Version tag prefix
VERSION_TAG_PREFIX=v
# Example: v1.2.0

# Commit message format
# type(scope): subject
# OR
# type-TICKET-ID-description: subject
#
# Valid types:
# - feature: New feature
# - fix: Bug fix
# - hotfix: Critical bug fix
# - release: Release preparation
# - docs: Documentation changes
# - style: Code style changes (formatting, etc.)
# - refactor: Code refactoring
# - test: Test additions or modifications
# - chore: Maintenance tasks

# Branch protection rules
PROTECTED_BRANCHES=(main develop)

# Merge options
MERGE_NO_FF=true  # Always create merge commits
DELETE_BRANCH_ON_MERGE=true  # Delete feature branches after merge (local only)

# Validation rules
REQUIRE_TICKET_ID=true  # Require ticket ID in branch names
VALIDATE_COMMIT_MSG=true  # Validate commit message format
RUN_TESTS_BEFORE_PUSH=true  # Run tests before allowing push

# Team workflow settings
REQUIRE_CODE_REVIEW=true  # Require code review before merge
AUTO_CREATE_PR=false  # Automatically create PR when pushing feature branch 