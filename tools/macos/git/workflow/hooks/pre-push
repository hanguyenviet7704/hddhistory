#!/bin/bash

# Pre-push hook for GitFlow validation
# This hook validates branch names and prevents direct pushes to protected branches

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Protected branches that should not receive direct pushes
PROTECTED_BRANCHES="main|master|develop"

# Get the current branch
CURRENT_BRANCH=$(git branch --show-current)

# Function to validate branch name format
validate_branch_name() {
    local branch="$1"
    
    # Skip validation for protected branches (they might already exist)
    if [[ "$branch" =~ ^($PROTECTED_BRANCHES)$ ]]; then
        return 0
    fi
    
    # Valid branch patterns
    local FEATURE_PATTERN="^feature/[A-Z]+-[0-9]+-[a-z0-9-]+$"
    local FIX_PATTERN="^fix/[A-Z]+-[0-9]+-[a-z0-9-]+$"
    local RELEASE_PATTERN="^release/[0-9]+\.[0-9]+\.[0-9]+$"
    local HOTFIX_PATTERN="^hotfix/[A-Z]+-[0-9]+-[a-z0-9-]+$"
    
    if [[ "$branch" =~ $FEATURE_PATTERN ]] || \
       [[ "$branch" =~ $FIX_PATTERN ]] || \
       [[ "$branch" =~ $RELEASE_PATTERN ]] || \
       [[ "$branch" =~ $HOTFIX_PATTERN ]]; then
        return 0
    fi
    
    return 1
}

# Check if pushing to protected branch
if [[ "$CURRENT_BRANCH" =~ ^($PROTECTED_BRANCHES)$ ]]; then
    echo -e "${YELLOW}⚠️  Warning: You're pushing directly to protected branch: $CURRENT_BRANCH${NC}"
    echo "Consider using GitFlow workflow with feature/fix/release/hotfix branches."
    echo ""
    read -p "Are you sure you want to continue? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${RED}❌ Push cancelled${NC}"
        exit 1
    fi
fi

# Validate branch name format
if ! validate_branch_name "$CURRENT_BRANCH"; then
    echo -e "${RED}❌ Invalid branch name format: $CURRENT_BRANCH${NC}"
    echo ""
    echo -e "${GREEN}Valid formats:${NC}"
    echo "  feature/TICKET-ID-description  (e.g., feature/TG-123-login-social)"
    echo "  fix/TICKET-ID-description      (e.g., fix/TG-456-validation-bug)"
    echo "  release/VERSION                (e.g., release/1.2.0)"
    echo "  hotfix/TICKET-ID-description   (e.g., hotfix/TG-789-critical-fix)"
    echo ""
    echo -e "${YELLOW}Please rename your branch to follow the GitFlow convention.${NC}"
    exit 1
fi

# Check for work-in-progress commits
WIP_COMMITS=$(git log origin/$CURRENT_BRANCH..HEAD --grep="WIP\|wip\|Work in progress" --oneline)
if [[ -n "$WIP_COMMITS" ]]; then
    echo -e "${YELLOW}⚠️  Found work-in-progress commits:${NC}"
    echo "$WIP_COMMITS"
    echo ""
    echo "Consider squashing or rewording these commits before pushing."
    read -p "Push anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${RED}❌ Push cancelled${NC}"
        echo "Use 'git rebase -i' to clean up your commits."
        exit 1
    fi
fi

# Run tests if available
if [ -f "pubspec.yaml" ] && command -v flutter &> /dev/null; then
    echo -e "${YELLOW}🧪 Running Flutter analyze...${NC}"
    flutter analyze --no-fatal-infos
    if [ $? -ne 0 ]; then
        echo -e "${RED}❌ Flutter analyze found issues${NC}"
        echo "Please fix the issues before pushing."
        exit 1
    fi
fi

echo -e "${GREEN}✅ Pre-push validation passed!${NC}"
exit 0 