# Error Handling Rules

## AppException Pattern

Use AppException for all application errors instead of generic exceptions.

### AppException Definition

```dart
@freezed
class AppException with _$AppException implements Exception {
  const factory AppException.serverError({
    required String message,
    String? code,
    int? statusCode,
  }) = _ServerError;

  const factory AppException.networkError({
    String? message,
  }) = _NetworkError;

  const factory AppException.unauthorizedError({
    String? message,
  }) = _UnauthorizedError;

  const factory AppException.validationError({
    required String message,
    Map<String, List<String>>? fieldErrors,
  }) = _ValidationError;

  const factory AppException.notFoundError({
    String? message,
  }) = _NotFoundError;

  const factory AppException.unknownError({
    required String message,
    Exception? originalException,
  }) = _UnknownError;

  const AppException._();

  String get displayMessage => when(
    serverError: (message, code, statusCode) => message,
    networkError: (message) => message ?? 'Network connection failed',
    unauthorizedError: (message) => message ?? 'Access denied',
    validationError: (message, fieldErrors) => message,
    notFoundError: (message) => message ?? 'Resource not found',
    unknownError: (message, originalException) => message,
  );

  factory AppException.fromException(Exception exception) {
    if (exception is DioException) {
      return AppException.fromDioException(exception);
    }

    return AppException.unknownError(
      message: exception.toString(),
      originalException: exception,
    );
  }

  factory AppException.fromDioException(DioException dioException) {
    switch (dioException.type) {
      case DioExceptionType.connectionTimeout:
      case DioExceptionType.receiveTimeout:
      case DioExceptionType.sendTimeout:
        return const AppException.networkError(
          message: 'Connection timeout. Please try again.',
        );

      case DioExceptionType.connectionError:
        return const AppException.networkError(
          message: 'No internet connection. Please check your network.',
        );

      case DioExceptionType.badResponse:
        final statusCode = dioException.response?.statusCode;
        final message = dioException.response?.data?['message'] ??
                        'Server error occurred';

        switch (statusCode) {
          case 401:
            return AppException.unauthorizedError(message: message);
          case 404:
            return AppException.notFoundError(message: message);
          case 422:
            return AppException.validationError(
              message: message,
              fieldErrors: _parseFieldErrors(dioException.response?.data),
            );
          default:
            return AppException.serverError(
              message: message,
              statusCode: statusCode,
            );
        }

      default:
        return AppException.unknownError(
          message: dioException.message ?? 'An unexpected error occurred',
          originalException: dioException,
        );
    }
  }

  static Map<String, List<String>>? _parseFieldErrors(dynamic data) {
    if (data is Map<String, dynamic> && data.containsKey('errors')) {
      final errors = data['errors'] as Map<String, dynamic>?;
      if (errors != null) {
        return errors.map((key, value) {
          if (value is List) {
            return MapEntry(key, value.cast<String>());
          } else if (value is String) {
            return MapEntry(key, [value]);
          }
          return MapEntry(key, [value.toString()]);
        });
      }
    }
    return null;
  }
}
```

## Either Pattern for Results

### Repository Return Types

```dart
abstract class IUserRepository {
  TaskEither<AppException, User> getUser(String id);
  TaskEither<AppException, List<User>> getUsers();
  TaskEither<AppException, User> createUser(CreateUserRequest request);
  TaskEither<AppException, void> deleteUser(String id);
}
```

### Repository Implementation

```dart
@LazySingleton(as: IUserRepository)
class UserRepository implements IUserRepository {
  final UserApiClient apiClient;

  UserRepository(this.apiClient);

  @override
  TaskEither<AppException, User> getUser(String id) async {
    try {
      final response = await apiClient.getUser(id);
      final user = response.data.toEntity();
      return Right(user);
    } catch (e) {
      return Left(AppException.fromException(e as Exception));
    }
  }
}
```

### Use Case Error Handling

```dart
@lazySingleton
class GetUserUseCase extends UseCaseWithParams<User, GetUserParams> {
  final IUserRepository repository;

  GetUserUseCase(this.repository);

  @override
  TaskEither<AppException, User> call(GetUserParams params) async {
    // Validation
    if (params.userId.isEmpty) {
      return const Left(AppException.validationError(
        message: 'User ID cannot be empty',
      ));
    }

    // Business logic
    final result = await repository.getUser(params.userId);

    return result.fold(
      (error) => Left(error),
      (user) {
        // Additional business logic here if needed
        return Right(user);
      },
    );
  }
}
```

## BLoC Error Handling

### State with Error Handling

```dart
@freezed
class UserState with _$UserState {
  const factory UserState.initial() = _Initial;
  const factory UserState.loading() = _Loading;
  const factory UserState.success(User user) = _Success;
  const factory UserState.error(AppException exception) = _Error;
}
```

### Cubit Error Handling

```dart
@injectable
class UserCubit extends HydratedCubit<UserState> {
  final GetUserUseCase getUserUseCase;

  UserCubit(this.getUserUseCase) : super(const UserState.initial());

  Future<void> loadUser(String userId) async {
    emit(const UserState.loading());

    final result = await getUserUseCase(GetUserParams(userId: userId));

    result.fold(
      (error) => emit(UserState.error(error)),
      (user) => emit(UserState.success(user)),
    );
  }

  void clearError() {
    state.whenOrNull(
      error: (_) => emit(const UserState.initial()),
    );
  }
}
```

## UI Error Display

### Error Widget

```dart
class ErrorDisplay extends StatelessWidget {
  final AppException exception;
  final VoidCallback? onRetry;
  final String? customMessage;

  const ErrorDisplay({
    super.key,
    required this.exception,
    this.onRetry,
    this.customMessage,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(16),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            _getErrorIcon(),
            size: 64,
            color: Theme.of(context).colorScheme.error,
          ),
          const SizedBox(height: 16),
          Text(
            customMessage ?? exception.displayMessage,
            textAlign: TextAlign.center,
            style: Theme.of(context).textTheme.titleMedium,
          ),
          if (onRetry != null) ...[
            const SizedBox(height: 24),
            ElevatedButton(
              onPressed: onRetry,
              child: Text(context.l10n.retry),
            ),
          ],
        ],
      ),
    );
  }

  IconData _getErrorIcon() {
    return exception.when(
      serverError: (_, __, ___) => Icons.error_outline,
      networkError: (_) => Icons.wifi_off,
      unauthorizedError: (_) => Icons.lock_outline,
      validationError: (_, __) => Icons.warning_outlined,
      notFoundError: (_) => Icons.search_off,
      unknownError: (_, __) => Icons.help_outline,
    );
  }
}
```

### Error Handling in Views

```dart
class UserView extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: BlocBuilder<UserCubit, UserState>(
        builder: (context, state) {
          return state.when(
            initial: () => const SizedBox.shrink(),
            loading: () => const Center(child: CircularProgressIndicator()),
            success: (user) => UserContent(user: user),
            error: (exception) => ErrorDisplay(
              exception: exception,
              onRetry: () => context.read<UserCubit>().loadUser(user.id),
            ),
          );
        },
      ),
    );
  }
}
```

### Snackbar Error Display

```dart
BlocListener<UserCubit, UserState>(
  listener: (context, state) {
    state.whenOrNull(
      error: (exception) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(exception.displayMessage),
            backgroundColor: Theme.of(context).colorScheme.error,
            action: SnackBarAction(
              label: context.l10n.dismiss,
              onPressed: () => context.read<UserCubit>().clearError(),
            ),
          ),
        );
      },
    );
  },
  child: UserContent(),
)
```

## Validation Error Handling

### Form Validation with AppException

```dart
class UserFormCubit extends Cubit<UserFormState> {
  UserFormCubit() : super(const UserFormState.initial());

  Future<void> submitForm(UserFormData formData) async {
    // Client-side validation
    final validationResult = _validateForm(formData);
    if (validationResult != null) {
      emit(UserFormState.error(validationResult));
      return;
    }

    emit(const UserFormState.loading());

    final result = await createUserUseCase(CreateUserParams.fromFormData(formData));

    result.fold(
      (error) => emit(UserFormState.error(error)),
      (user) => emit(UserFormState.success(user)),
    );
  }

  AppException? _validateForm(UserFormData formData) {
    final errors = <String, List<String>>{};

    if (formData.email.isEmpty) {
      errors['email'] = ['Email is required'];
    } else if (!_isValidEmail(formData.email)) {
      errors['email'] = ['Invalid email format'];
    }

    if (formData.password.length < 8) {
      errors['password'] = ['Password must be at least 8 characters'];
    }

    if (errors.isNotEmpty) {
      return AppException.validationError(
        message: 'Please fix the following errors:',
        fieldErrors: errors,
      );
    }

    return null;
  }
}
```

## Testing Error Handling

### Testing AppException Creation

```dart
group('AppException', () {
  test('should create correct exception from DioException', () {
    final dioException = DioException(
      requestOptions: RequestOptions(path: '/test'),
      response: Response(
        requestOptions: RequestOptions(path: '/test'),
        statusCode: 404,
        data: {'message': 'User not found'},
      ),
    );

    final appException = AppException.fromDioException(dioException);

    expect(appException, isA<_NotFoundError>());
    expect(appException.displayMessage, equals('User not found'));
  });
});
```

### Testing Use Case Error Handling

```dart
group('GetUserUseCase', () {
  test('should return validation error for empty user ID', () async {
    final useCase = GetUserUseCase(mockRepository);

    final result = await useCase(const GetUserParams(userId: ''));

    expect(result.isLeft(), true);
    result.fold(
      (error) => expect(error, isA<_ValidationError>()),
      (user) => fail('Expected validation error'),
    );
  });
});
```
