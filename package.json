{
  "name": "hddhistory-api",
  "version": "1.0.0",
  "description": "Backend API cho HDDhistory — học lịch sử Việt Nam bằng đồ thị tri thức.",
  "main": "apps/main.ts",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "seed:habits": "ts-node scripts/seed-habits.ts",
    "seed:study-themes": "ts-node scripts/seed-study-themes.ts",
    "seed:chat-rooms": "ts-node scripts/seed-community-chat-rooms.ts",
    "seed:knowledge-graph": "ts-node scripts/seed-knowledge-graph.ts",
    "backfill:keypoint-entities": "ts-node -r ./scripts/_register-aliases.js scripts/backfill-keypoint-entities.ts",
    "seed:dev-user": "ts-node -r ./scripts/_register-aliases.js scripts/seed-dev-user.ts",
    "seed:vn-history": "ts-node -r ./scripts/_register-aliases.js scripts/seed-vn-history.ts",
    "fetch:card-images": "ts-node scripts/fetch-card-images.ts",
    "gen:placeholder-images": "ts-node scripts/generate-placeholder-images.ts",
    "setup:local-mysql": "ts-node -r tsconfig-paths/register scripts/setup-local-mysql.ts",
    "backfill:audio-clips": "ts-node scripts/backfill-audio-clips.ts",
    "lint": "eslint \"{src,base,modules,test}/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.3.4",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^9.2.2",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/platform-socket.io": "^9.4.3",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^6.3.0",
    "@nestjs/typeorm": "^9.0.1",
    "@nestjs/websockets": "^9.4.3",
    "archiver": "^5.3.2",
    "aws4fetch": "^1.0.20",
    "axios": "^0.21.4",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.0",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.5.0",
    "googleapis": "^166.0.0",
    "install": "^0.13.0",
    "joi": "^17.0.0",
    "mongodb": "^6.21.0",
    "mongoose": "^6.13.8",
    "msedge-tts": "^2.0.7",
    "mysql2": "^3.11.3",
    "neo4j-driver": "^6.2.0",
    "nestjs-i18n": "^10.5.1",
    "npm": "^11.6.2",
    "openapi-to-postmanv2": "^5.1.0",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "winston": "^3.0.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@types/archiver": "^5.3.4",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^16.0.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "prettier": "^2.5.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.0.0",
    "typescript": "^4.5.0"
  },
  "keywords": [
    "nestjs",
    "ai",
    "tutor",
    "chat",
    "socket"
  ],
  "author": "Your Name",
  "license": "MIT",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata"
    ],
    "moduleNameMapper": {
      "^@base/(.*)$": "<rootDir>/base/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
