<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 (API 35) enforces edge-to-edge: app content is drawn under
         the system navigation bar, so every screen whose bottom UI isn't
         wrapped in a SafeArea gets covered by the 3-button nav bar. Opt out
         globally (valid through Android 16) to restore the pre-35 behavior
         while screens are migrated to proper SafeArea usage. -->
    <!-- Keep drawing under the TOP (status bar + camera cutout) so screens keep
         their full-bleed headers — the opt-out alone leaves a black band there.
         The bottom nav bar still gets its own reserved strip. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
