<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 (API 35) enforces edge-to-edge: app content is drawn under
         the system navigation bar, so every screen whose bottom UI isn't
         wrapped in a SafeArea gets covered by the 3-button nav bar. Opt out
         globally (valid through Android 16) to restore the pre-35 behavior
         while screens are migrated to proper SafeArea usage. -->
    <!-- Keep drawing under the TOP (status bar + camera cutout) so screens keep
         their full-bleed headers — the opt-out alone leaves a black band there.
         The bottom nav bar still gets its own reserved strip. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
        <!-- Hide the circle-masked OS splash icon so the square brand "?" tile
             shows once (Flutter splash) — otherwise it reads as two splashes. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Match the light Flutter splash (was ?android:colorBackground = system
             white/gray, which flashed gray between the OS splash and Flutter on
             API 35 — the v35 twin of the fix that only landed in values/). -->
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
