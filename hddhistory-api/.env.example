PORT=****

#MONGODB
MONGODB_URI=****/hddhistory-api

#MYSQL
MYSQL_HOST=****
MYSQL_PORT=****
MYSQL_USERNAME=****
MYSQL_PASSWORD=****
MYSQL_DB=****

#JWT
JWT_SECRET=****
# Not read: the access token lifetime is the ACCESS_TOKEN_EXPIRES_IN constant in
# auth.service.ts. Kept in step with it so the file does not mislead.
JWT_EXPIRATION='7d'
# Read by signToken. It used to be 7d — the same as the access token, signed at
# the same moment and never reissued, so every session died 7 days after login
# however often the app was opened.
JWT_REFRESH_EXPIRATION='180d'

#DEVICE
MAX_DEVICE=2

#R2
CLOUDFLARE_R2_ACCOUNT_ID=****
CLOUDFLARE_R2_ACCESS_KEY_ID=****
CLOUDFLARE_R2_SECRET_ACCESS_KEY=****
CLOUDFLARE_R2_BUCKET_NAME=****
CLOUDFLARE_R2_CDN=****

# VOICEOVER — no key needed: dubbing runs on the free Microsoft Edge
# "Read Aloud" neural voices (msedge-tts). It only needs outbound internet from
# the server. Google Cloud Chirp3-HD was tried twice and reverted both times —
# it bills per character and the second attempt failed 1634 of 2395 cells — so
# there is no TTS key to set here.
#
# How many synthesis+upload calls one keypoint runs at once. Optional; defaults
# to 6. Five concurrent calls measured 1.1s against 26.5s sequential; 16 still
# all succeeded but stretched the slowest from ~1.5s to ~15s, so raise this only
# if a dub run is the only thing the process is doing.
VOICEOVER_CONCURRENCY=6

# VBEE — the PAID Vietnamese TTS provider, used only where a course is
# explicitly switched to it (`course.voiceoverViProvider = 'vbee'`), and only
# for `vi`. Everything else keeps running on the free Edge voices above.
#
# Billed per CHARACTER, so nothing here is a default anybody should turn on
# catalogue-wide. Leave APP_ID/TOKEN empty and the provider reports itself as
# unconfigured: the toggle refuses, and no dub can silently fall through to it.
VBEE_APP_ID=
VBEE_TOKEN=
# Fallback narrator when the admin has not picked one yet. HN - Ngọc Huyền,
# female, credit_factor 1 — the cheapest tier and the closest match to the Edge
# narrator it replaces. The "nâng cao (Beta)" voices bill 2x and the "2.0" ones
# 3x, which is why the admin picker shows the factor next to every name.
VBEE_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg
# 64kbps mono. The bitrate cannot match Edge's 48 (Vbee offers only
# 8/16/32/64/128), which is exactly why a language must be re-dubbed wholesale
# rather than clip by clip — see `voiceover-merge.service.ts`, which concats
# with `-c copy`.
VBEE_BITRATE=64
# LEAVE EMPTY. Every voice supports its own set of sample rates (one answers
# "This voice only support sample rate of [8000,16000,22050]"), so any single
# hardcoded value breaks some voice — and only once the job has already run.
# Empty = Vbee uses the highest rate that voice supports. It costs nothing:
# MP3 size follows the BITRATE, not the sample rate. Pin a value only if you
# have a reason, and force a re-dub of `vi` when you change it, or one language
# ends up holding clips of two rates that `-c copy` cannot splice.
VBEE_SAMPLE_RATE=
VBEE_SPEED=1.0
# Lower than VOICEOVER_CONCURRENCY: VBee answers 429
# (TTS_CCR_MAX_LIMIT_REACHED) past an undocumented concurrency ceiling, and a
# refused request here costs a retry rather than being free.
VBEE_CONCURRENCY=3
# Hard stop, in characters, for a single dub run. One mis-click on a
# catalogue-wide button must not be able to drain the balance.
VBEE_MAX_CHARS_PER_RUN=200000

# PAYMENT
APPLE_ISSUER_ID=****
APPLE_KEY_ID=****
APPLE_BUNDLE_ID=****
APPLE_SHARED_SECRET=**** # optional, required for verifyReceipt (subscriptions)
GOOGLE_WEBHOOK_AUDIENCE=****

# GOOGLE DRIVE CONTENT SYNC (course-content-transfers)
# Folder that holds one Google Sheet per course, shared (Editor) with the
# google-service.json service account; Drive + Sheets API enabled. The sync
# never CREATES files (service accounts own no My-Drive quota): the sheet for
# a course — and _TEMPLATE — is hand-created blank in the folder first, then
# the sync fills it and claims it via the meupCourseId appProperty. A plain
# My-Drive folder works; a Shared Drive also works (supportsAllDrives is on).
GOOGLE_DRIVE_CONTENT_FOLDER_ID=****
# Alternative to a Shared Drive: a Workspace user the service account
# impersonates (needs domain-wide delegation for the SA's client ID with the
# drive scope). Files are then owned by this user, so a plain My-Drive folder
# of theirs works.
GOOGLE_DRIVE_IMPERSONATE_SUBJECT=

# OUTPUT PRACTICE AI
OUTPUT_PRACTICE_AI_HOST=
OUTPUT_PRACTICE_AI_SECRET_TOKEN=

# LEARNING IMPORT (PDF / YouTube -> generated lesson)
# Optional. Without a key the API boots and behaves exactly as before; only
# POST /api/v1/learning-imports rejects, with AI_NOT_CONFIGURED.
# THE ONLY source for the key -- there is no fallback in code, so every
# environment that needs the feature must set it (local .env and k8s config).
GEMINI_API_KEY=
# Model id lives here so it can be changed for cost, quality or a deprecation
# without a deploy. Empty = gemini-flash-latest, an ALIAS on purpose: this
# feature has already broken twice on a pinned model being retired.
GEMINI_MODEL=gemini-flash-lite-latest
# Where a Coach call goes when its own model answers 429/503 -- comma-separated,
# best first, tried in order with no pause between hops. Empty = the built-in
# pair (gemini-flash-latest,gemini-flash-lite-latest). The admin Coach config
# overrides this, and "off" there stops the hopping altogether.
GEMINI_FALLBACK_MODELS=
# Whole budget for one generation, in ms. Defaults to 600000 (10 min) -- these
# are multi-minute requests and Node's fetch has no timeout of its own.
GEMINI_TIMEOUT_MS=

# AFFILIATE ORDERS (POST /api/v1/purchase/affiliateOrder -- shared secret,
# checked against the request body's `key_project`)
AFFILIATE_ORDERS_SECRET_TOKEN=

# DOWNLOAD LINKS (GET /api/v1/r/:slug -- click tracking)
# Optional. Salt for hashing click IPs. Leave empty and clicks are still
# counted, but with a NULL ip_hash, so the "unique clickers" figure reports as
# "not measured" rather than 0. Never stores a raw IP either way.
DOWNLOAD_LINK_IP_SALT=

# REGIONAL PRICE SYNC (POST /api/v1/payment/products/prices/sync)
# App Store Connect API credentials -- distinct from APPLE_ISSUER_ID/
# APPLE_KEY_ID above (those are for the App Store Server API). Must be set
# before the Apple side of the sync can run.
# Bundle whose prices we read. IAP products live ONLY under the production app
# record (com.hddhistory.app.dev / .stg have no App Store Connect app), so on dev/stg
# this must stay the PRODUCTION bundle even though APPLE_BUNDLE_ID above is the
# environment's own. Unset = falls back to APPLE_BUNDLE_ID.
APPLE_ASC_BUNDLE_ID=com.hddhistory.app
APPLE_ASC_KEY_ID=****
APPLE_ASC_ISSUER_ID=****
# Supply the key EITHER as raw PEM content here, OR as a mounted file path in
# APPLE_ASC_KEY_PATH (same convention as APPLE_KEY_PATH for the Server API key,
# since `keys/` is excluded from the image). Raw content wins if both are set.
# NOTE: this must be an App Store CONNECT API key -- the existing
# SubscriptionKey (APPLE_KEY_ID) is an In-App Purchase key and cannot call
# /v1/apps or /v1/subscriptions/.../prices.
APPLE_ASC_PRIVATE_KEY=****
APPLE_ASC_KEY_PATH=**** # e.g. keys/AuthKey_697CNSDLVW.p8
# Android package name for the Play Developer "monetization" API. Reading
# monetization data needs a Play Console permission separate from purchase
# verification -- see plans/260727-voucher-paywall-config-affiliate/design.md
# Part 2. Left unset, the Google side of the sync is skipped (not failed).
GOOGLE_PACKAGE_NAME=****

#environment
NODE_ENV=development

# Đồ thị tri thức lịch sử (module knowledge-graph). Cả ba biến đều TUỲ CHỌN:
# thiếu thì module trả 503 chứ app vẫn khởi động bình thường, nhờ vậy các môi
# trường chưa dựng Neo4j không bị chết vì một tính năng chưa bật.
# Dựng cục bộ:
#   docker run -d --name hddhistory-neo4j -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/<mật khẩu> neo4j:5-community
# Nạp dữ liệu: npm run seed:knowledge-graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=****
